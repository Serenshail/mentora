# 参赛独立环境配置模板（ICT Track1）
#
# 用法：复制为 D:/zcode/agent/mentora/.env.ict 后填入真实值。
# 纪律：
#   1) 本文件是唯一参赛配置入口，部署脚本只用 --env-file .env.ict
#   2) 不继承生产 .env.local：尤其不得出现 CLOUDFLARE_D1_* / GITHUB_DB_* / VERCEL_OIDC_TOKEN
#   3) 真实值不得入仓；.env* 已被 .gitignore 覆盖
#   4) AUTH_SECRET 必须使用独立随机值（与生产不同），否则两边会话可互相解密

# ---------- 数据通道（参赛 = 华为云） ----------
DB_CHANNEL=huawei
DATABASE_URL=postgresql://ict_user:CHANGE_ME@<rds-host>:5432/mentora_ict
REDIS_URL=rediss://:<dcs-password>@<dcs-host>:6379/0

# ---------- 模型通道（参赛 = 华为云 MaaS） ----------
AI_PROVIDER=maas
MAAS_BASE_URL=https://<maas-endpoint>
MAAS_API_KEY=CHANGE_ME
AI_MODEL=<maas-model-name>

# ---------- 认证（独立） ----------
AUTH_SECRET=CHANGE_ME_64_HEX_CHARS
ADMIN_PASSWORD=CHANGE_ME
INVITE_CODE=CHANGE_ME
MENTORA_OPEN_TOKEN=CHANGE_ME

# ---------- 明确禁用项（留空或删除，不得填生产值） ----------
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_D1_DATABASE_ID=
# CLOUDFLARE_D1_API_TOKEN=
# GITHUB_DB_REPO=
# GITHUB_DB_TOKEN=
# VERCEL_OIDC_TOKEN=