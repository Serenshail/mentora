{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/app/api/**/route.ts": {
      "maxDuration": 60
    }
  },
  "regions": [
    "hkg1"
  ],
  "crons": [
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 1 * * 1"
    },
    {
      "path": "/api/cron/expiry-reminder",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/tick",
      "schedule": "0 23 * * *"
    }
  ]
}
