# Mentora 环境变量样例（占位值，凭据绝不入仓）
# 复制为 .env.local 本地使用；华为云部署时经编排配置/控制台注入。

# ---- 必需 ----
AUTH_SECRET=change-me-32bytes-random

# ---- 模型通道（双通道：AI_PROVIDER 显式指定，缺省按下方 Key 遍历兜底） ----
# 部署环境（华为云）显式设为 custom + 下三行；本地开发可留空走遍历或演示模式
# AI_PROVIDER=custom
# CUSTOM_API_KEY=
# AI_BASE_URL=https://tokenrhythm.studio/v1         # 仅 AI_PROVIDER=custom 时生效（OpenAI 兼容端点）
# AI_MODEL=qwen3.8-flash                            # custom 通道必须显式指定模型名
# MAAS_API_KEY=                                     # 备用通道：华为云 MaaS
# MAAS_BASE_URL=https://api.modelarts-maas.com/v1   # 可选，缺省用内置注册表地址
# DEEPSEEK_API_KEY=
# ZAI_API_KEY=
# MOONSHOT_API_KEY=
# OPENAI_API_KEY=
# AI_CHEAP_MODEL=                                   # 判分分级快模型（BYOK 不受影响）
# EMBED_MODEL=                                      # 嵌入模型（服务端 RAG 向量混排，可选；未配置=纯 BM25 与现状一致）
# EMBED_API_KEY=                                    # 缺省回落 MAAS_API_KEY
# EMBED_BASE_URL=                                   # 缺省回落 MAAS_BASE_URL / 内置 MaaS 地址

# ---- 存储通道（双通道：DB_CHANNEL 显式路由，缺省 auto 隐式优先级 Upstash→D1→GitHub） ----
# DB_CHANNEL=auto                                   # auto | huawei | upstash | d1 | github
# DATABASE_URL=                                     # 华为云 RDS PostgreSQL（DB_CHANNEL=huawei）
# REDIS_URL=                                        # 华为云 DCS Redis（DB_CHANNEL=huawei）
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_D1_DATABASE_ID=
# CLOUDFLARE_D1_API_TOKEN=
# GITHUB_DB_TOKEN=
# GITHUB_DB_REPO=

# ---- 管理 / 定时 / 发信 ----
# ADMIN_PASSWORD=
# GITHUB_TOKEN=
# CRON_SECRET=
# RESEND_API_KEY=
# MAIL_FROM=
# APP_URL=https://your-demo.example.com
# 免费版（含到期降级用户）每月 AI token 预算；不设默认 200000
# FREE_MONTHLY_TOKENS=200000
# 激活码在后台「卡密管理」生成，不再需要 INVITE_CODE（旧变量已停用）

# ---- 反向代理 ----
# 本站前面有几层代理会往 X-Forwarded-For 末尾追加真实对端地址（默认 1）。
# 取值必须是可信代理跳数：Caddy/ELB 直连=1；LB→Caddy→应用=2。
# 绝不能设大来"信任"客户端自填的前缀，否则限流键可被伪造轮换。
# TRUSTED_PROXY_HOPS=1