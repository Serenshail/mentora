/* ============================================================
 * Mentora 小程序 · 设计系统 v2（2026-11-01 重做）
 *
 * 三条纪律：
 * 1. 白纸底。页面是纸，不是"灰底上浮着一堆卡片"。分区用发丝线与留白，
 *    只有真正的交互对象（输入、按钮、弹层）才成"形"。
 * 2. 字先说话。标题大而有重量（-1rpx 字距收紧），正文 30rpx / 1.75 行高；
 *    灰色只做层级，不做装饰。
 * 3. 一个强调色，只给状态与动作。靛蓝出现的地方必须"值得看"。
 * ============================================================ */
page {
  --paper: #ffffff;
  --wash: #f6f6f7;          /* 输入底 / 轻微分区 */
  --ink: #101114;           /* 主文字：比 #1d1d1f 更实 */
  --ink-2: #5c6068;         /* 次级 */
  --ink-3: #8e939c;         /* 三级 / 说明 */
  --hairline: rgba(16, 17, 20, 0.08);
  --hairline-soft: rgba(16, 17, 20, 0.05);
  --accent: #4f46e5;
  --accent-wash: rgba(79, 70, 229, 0.07);
  --ok: #0b7a52;
  --ok-wash: rgba(11, 122, 82, 0.08);
  --warn: #a35a00;
  --warn-wash: rgba(163, 90, 0, 0.09);
  --bad: #c9291d;
  --bad-wash: rgba(201, 41, 29, 0.07);

  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC",
    "Hiragino Sans GB", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* ---------------- 版式 ---------------- */
.display {
  font-size: 60rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1.15;
  color: var(--ink);
}
.title {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: -1.2rpx;
  line-height: 1.25;
  color: var(--ink);
}
.h2 { font-size: 36rpx; font-weight: 700; letter-spacing: -0.8rpx; line-height: 1.35; color: var(--ink); }
.h3 { font-size: 31rpx; font-weight: 600; letter-spacing: -0.3rpx; color: var(--ink); }
.body { font-size: 30rpx; line-height: 1.75; color: var(--ink); }
.sub { font-size: 27rpx; line-height: 1.6; color: var(--ink-2); }
.note { font-size: 24rpx; line-height: 1.55; color: var(--ink-3); }
.micro { font-size: 21rpx; line-height: 1.5; color: var(--ink-3); letter-spacing: 0.4rpx; }
.mono { font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; }
.num { font-variant-numeric: tabular-nums; }
.ink-2 { color: var(--ink-2); }
.ink-3 { color: var(--ink-3); }
.accent { color: var(--accent); }
.ok { color: var(--ok); }
.warn { color: var(--warn); }
.bad { color: var(--bad); }
.strong { font-weight: 600; }

/* 小节眉标：短横 + 小字，替代"卡片标题"。短横是真实节点（WXSS 不依赖 ::before） */
.eyebrow {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: var(--ink-3);
}
.eyebrow-mark {
  width: 28rpx;
  height: 3rpx;
  background: var(--ink);
  border-radius: 2rpx;
  opacity: 0.85;
  flex-shrink: 0;
}

/* ---------------- 布局 ---------------- */
.page { padding: 28rpx 36rpx calc(48rpx + env(safe-area-inset-bottom)); }
.page-tight { padding: 0 36rpx calc(48rpx + env(safe-area-inset-bottom)); }
.sec { margin-top: 48rpx; }
.sec-sm { margin-top: 32rpx; }
.row { display: flex; align-items: center; }
.between { display: flex; align-items: center; justify-content: space-between; }
.gap-8 { gap: 8rpx; }
.gap-12 { gap: 12rpx; }
.gap-16 { gap: 16rpx; }
.gap-20 { gap: 20rpx; }
.flex-1 { flex: 1; min-width: 0; }
.wrap { flex-wrap: wrap; }
.hairline { height: 1rpx; background: var(--hairline); }

/* 分区（替代卡片）：只有名字和内容，没有边框与阴影 */
.block { padding: 28rpx 0; border-top: 1rpx solid var(--hairline); }
.block:first-child { border-top: none; }

/* 真正需要"形"的地方：可点的大对象 */
.surface {
  background: var(--paper);
  border: 1rpx solid var(--hairline);
  border-radius: 32rpx;
  padding: 34rpx;
}
.surface-wash {
  background: var(--wash);
  border-radius: 28rpx;
  padding: 30rpx;
}

/* 列表行 */
.line {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--hairline);
}
.line:last-child { border-bottom: none; }
.line-title { font-size: 30rpx; font-weight: 600; color: var(--ink); letter-spacing: -0.2rpx; }
.line-sub { font-size: 24rpx; color: var(--ink-3); margin-top: 6rpx; }
.chev { color: #c3c7cf; font-size: 30rpx; font-weight: 400; }

/* ---------------- 按钮 ---------------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
  font-size: 31rpx;
  font-weight: 600;
  letter-spacing: 0.2rpx;
  border: none;
  box-sizing: border-box;
}
.btn::after { border: none; }
.btn-ink { background: var(--ink); color: #fff; }
.btn-accent { background: var(--accent); color: #fff; }
.btn-outline { background: transparent; color: var(--ink); border: 1.5rpx solid var(--hairline); }
.btn-quiet { background: var(--wash); color: var(--ink); }
.btn-danger { background: var(--bad-wash); color: var(--bad); }
.btn-block { display: flex; width: 100%; }
.btn-sm { height: 68rpx; padding: 0 28rpx; font-size: 26rpx; font-weight: 600; }
.btn-xs { height: 56rpx; padding: 0 22rpx; font-size: 23rpx; font-weight: 600; }
.btn.disabled { opacity: 0.32; }
.tap-dim { opacity: 0.6; }

/* 文字动作（列表右侧、行内） */
.link-action {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent);
  padding: 8rpx 0;
}

/* ---------------- 徽标 / 药丸 ---------------- */
.pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 44rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  background: var(--wash);
  color: var(--ink-2);
}
.pill-accent { background: var(--accent-wash); color: var(--accent); }
.pill-ok { background: var(--ok-wash); color: var(--ok); }
.pill-warn { background: var(--warn-wash); color: var(--warn); }
.pill-bad { background: var(--bad-wash); color: var(--bad); }
.pill-ink { background: var(--ink); color: #fff; }
.pill-ghost { background: transparent; border: 1.5rpx solid var(--hairline); color: var(--ink-2); }

.dot { width: 12rpx; height: 12rpx; border-radius: 50%; display: inline-block; flex-shrink: 0; }
.dot-ok { background: var(--ok); }
.dot-warn { background: var(--warn); }
.dot-bad { background: var(--bad); }
.dot-accent { background: var(--accent); }
.dot-idle { background: #d4d7dd; }

/* ---------------- 表单 ---------------- */
.field { padding: 26rpx 0; border-bottom: 1rpx solid var(--hairline); }
.field-label {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: var(--ink-3);
  margin-bottom: 12rpx;
}
.field-input {
  width: 100%;
  font-size: 34rpx;
  color: var(--ink);
  line-height: 1.5;
  min-height: 52rpx;
}
.input-pill {
  width: 100%;
  height: 84rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: var(--wash);
  font-size: 29rpx;
  color: var(--ink);
  box-sizing: border-box;
}
.area {
  width: 100%;
  min-height: 200rpx;
  padding: 26rpx 28rpx;
  border-radius: 24rpx;
  background: var(--wash);
  font-size: 30rpx;
  line-height: 1.7;
  color: var(--ink);
  box-sizing: border-box;
}

/* ---------------- 进度 ---------------- */
.bar { height: 6rpx; border-radius: 999rpx; background: rgba(16, 17, 20, 0.08); overflow: hidden; }
.bar-fill { height: 100%; border-radius: 999rpx; background: var(--ink); }
.bar-fill-accent { background: var(--accent); }

/* ---------------- 热力 ---------------- */
.heat { display: flex; gap: 7rpx; }
.heat-col { display: flex; flex-direction: column; gap: 7rpx; }
.heat-cell { width: 19rpx; height: 19rpx; border-radius: 5rpx; background: #f0f1f3; }
.heat-1 { background: rgba(79, 70, 229, 0.16); }
.heat-2 { background: rgba(79, 70, 229, 0.42); }
.heat-3 { background: var(--accent); }
.heat-future { opacity: 0.4; }

/* ---------------- 对话 ---------------- */
.chat { padding-bottom: 24rpx; }
.msg { margin: 22rpx 0; }
.msg-user { display: flex; justify-content: flex-end; }
.bubble {
  max-width: 82%;
  background: var(--ink);
  color: #fff;
  border-radius: 30rpx 30rpx 8rpx 30rpx;
  padding: 22rpx 28rpx;
  font-size: 30rpx;
  line-height: 1.65;
  word-break: break-word;
}
.msg-ai { padding-right: 12rpx; }
.msg-ai-name {
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 0.6rpx;
  color: var(--ink-3);
  margin-bottom: 10rpx;
}
.caret {
  display: inline-block;
  width: 3rpx;
  height: 30rpx;
  background: var(--ink);
  margin-left: 5rpx;
  vertical-align: -3rpx;
  animation: caret-blink 1s step-end infinite;
}
@keyframes caret-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
.thinking { font-size: 24rpx; color: var(--ink-3); }

/* 底部输入条 */
.composer {
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
  padding: 16rpx 0 calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--hairline);
  background: var(--paper);
}
.composer-input {
  flex: 1;
  min-height: 84rpx;
  max-height: 240rpx;
  padding: 20rpx 28rpx;
  border-radius: 999rpx;
  background: var(--wash);
  font-size: 29rpx;
  line-height: 1.5;
  box-sizing: border-box;
}
.composer-send {
  flex-shrink: 0;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: var(--ink);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}
.composer-send.disabled { opacity: 0.28; }

/* ---------------- 分段控件 ---------------- */
.segments {
  display: flex;
  gap: 6rpx;
  padding: 6rpx;
  border-radius: 999rpx;
  background: var(--wash);
}
.segment {
  flex: 1;
  height: 64rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-2);
}
.segment-on { background: var(--paper); color: var(--ink); box-shadow: 0 1rpx 3rpx rgba(16, 17, 20, 0.1); }

/* ---------------- 空态 ---------------- */
.blank { padding: 96rpx 0; text-align: center; }
.blank-title { font-size: 31rpx; font-weight: 600; color: var(--ink-2); }
.blank-sub { font-size: 25rpx; color: var(--ink-3); margin-top: 12rpx; line-height: 1.6; }

/* ---------------- 底部弹层 ---------------- */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(16, 17, 20, 0.32);
  z-index: 900;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 901;
  background: var(--paper);
  border-radius: 36rpx 36rpx 0 0;
  padding: 20rpx 36rpx calc(32rpx + env(safe-area-inset-bottom));
  max-height: 78vh;
  display: flex;
  flex-direction: column;
}
.sheet-grip {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #dcdfe4;
  margin: 0 auto 22rpx;
  flex-shrink: 0;
}
.sheet-scroll { flex: 1; min-height: 0; }

/* ============================================================
 * Markdown（wxml/md.wxml 使用；行内样式由 utils/md.js 注入）
 * ============================================================ */
.md-h { margin: 44rpx 0 16rpx; }
.md-h1 { font-size: 42rpx; font-weight: 700; letter-spacing: -1rpx; }
.md-h2 { font-size: 37rpx; font-weight: 700; letter-spacing: -0.8rpx; }
.md-h3 { font-size: 32rpx; font-weight: 600; }
.md-h4 { font-size: 30rpx; font-weight: 600; color: var(--ink-2); }
.md-p { margin: 18rpx 0; font-size: 30rpx; line-height: 1.8; color: var(--ink); }
.md-quote {
  margin: 24rpx 0;
  padding: 4rpx 0 4rpx 26rpx;
  border-left: 4rpx solid rgba(79, 70, 229, 0.35);
  color: var(--ink-2);
  font-size: 28rpx;
  line-height: 1.75;
}
.md-list { margin: 18rpx 0; }
.md-li { display: flex; margin: 12rpx 0; gap: 16rpx; }
.md-li-mark { color: var(--ink-3); font-weight: 700; flex-shrink: 0; min-width: 22rpx; }
.md-li-body { flex: 1; min-width: 0; font-size: 30rpx; line-height: 1.75; color: var(--ink); }
.md-hr { margin: 36rpx 0; height: 1rpx; background: var(--hairline); }
.md-table { margin: 24rpx 0; border-top: 1rpx solid var(--hairline); }
.md-tr { display: flex; border-bottom: 1rpx solid var(--hairline); }
.md-td { flex: 1; padding: 18rpx 16rpx 18rpx 0; font-size: 26rpx; line-height: 1.6; min-width: 0; }
.md-code { margin: 26rpx 0; background: #111214; border-radius: 24rpx; overflow: hidden; }
.md-code-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 26rpx 0;
}
.md-code-lang { color: #7c828c; font-size: 21rpx; letter-spacing: 0.6rpx; }
.md-code-copy {
  color: #b9bec6;
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
}
.md-code-scroll { padding: 18rpx 26rpx 26rpx; }
.md-code-text {
  color: #eceef1;
  font-family: ui-monospace, Menlo, Consolas, monospace;
  font-size: 24rpx;
  line-height: 1.65;
  white-space: pre;
}
