/* ============================================================
 * Mentora 小程序 · 设计系统
 *
 * 基准 = 网页版（src/app/globals.css，用户自己定的那套主题）：
 *   底色 #f5f5f7 · 纯白面板 · 发丝边框 rgba(0,0,0,.07)
 *   墨色 #1d1d1f / #6e6e73 / #86868b / #aeaeb2
 *   强调靛蓝 #5b54e6（只给聚焦、激活、链接）
 *   圆角 18px（36rpx） · 两层柔和阴影（紧凑接触层 + 柔和扩散层）
 *
 * 小程序这边唯一的改动是**把排版刻度换成手机可读尺寸**（rpx），
 * 视觉语言完全沿用网页版，不另起一套。
 * ============================================================ */
page {
  --bg: #f5f5f7;
  --surface: #ffffff;
  --surface-2: #f4f4f5;
  --border: rgba(0, 0, 0, 0.07);
  --ink: #1d1d1f;
  --ink-2: #6e6e73;
  --ink-3: #86868b;
  --faint: #d2d2d7;
  --placeholder: #aeaeb2;
  --track: #e8e8ed;
  --accent: #5b54e6;
  --accent-wash: rgba(91, 84, 230, 0.08);
  --ok: #047857;
  --ok-wash: rgba(4, 120, 87, 0.08);
  --warn: #b45309;
  --warn-wash: rgba(180, 83, 9, 0.08);
  --bad: #dc2626;
  --bad-wash: rgba(220, 38, 38, 0.07);

  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC",
    "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* ---------------- 文字层级 ---------------- */
.display {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: -1.6rpx;
  line-height: 1.18;
  color: var(--ink);
}
.title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: -1.2rpx;
  line-height: 1.25;
  color: var(--ink);
}
.h2 { font-size: 36rpx; font-weight: 700; letter-spacing: -0.7rpx; line-height: 1.35; color: var(--ink); }
.h3 { font-size: 31rpx; font-weight: 600; letter-spacing: -0.2rpx; color: var(--ink); }
.body { font-size: 30rpx; line-height: 1.72; color: var(--ink); }
.sub { font-size: 27rpx; line-height: 1.6; color: var(--ink-2); }
.meta { font-size: 24rpx; line-height: 1.5; color: var(--ink-3); }
.tiny { font-size: 21rpx; line-height: 1.45; color: var(--ink-3); }
.mono { font-family: ui-monospace, "SF Mono", Menlo, monospace; }
.num { font-variant-numeric: tabular-nums; }
.ink-2 { color: var(--ink-2); }
.ink-3 { color: var(--ink-3); }
.accent-text { color: var(--accent); }
.ok-text { color: var(--ok); }
.warn-text { color: var(--warn); }
.bad-text { color: var(--bad); }
.strong { font-weight: 600; }

/* ---------------- 容器 ---------------- */
.page { padding: 0 32rpx 60rpx; }
.sec { margin-top: 44rpx; }
.sec-sm { margin-top: 28rpx; }
.row { display: flex; align-items: center; }
.between { display: flex; align-items: center; justify-content: space-between; }
.gap-8 { gap: 8rpx; }
.gap-12 { gap: 12rpx; }
.gap-16 { gap: 16rpx; }
.gap-20 { gap: 20rpx; }
.flex-1 { flex: 1; min-width: 0; }
.wrap { flex-wrap: wrap; }

.page-head { padding: 24rpx 0 32rpx; }
.page-head-title { font-size: 44rpx; font-weight: 700; letter-spacing: -1.2rpx; line-height: 1.2; color: var(--ink); }
.page-head-sub { margin-top: 8rpx; font-size: 24rpx; color: var(--ink-3); }

/* ---------------- 卡片（网页版 card 同款：白面 + 发丝边 + 两层柔和阴影 + 18px 圆角） ---------------- */
.card {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 36rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.04), 0 16rpx 48rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}
.card + .card { margin-top: 24rpx; }
.card-tight { padding: 0; }
.card-flat {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  padding: 26rpx;
  box-sizing: border-box;
}

.card-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.card-row:last-child { border-bottom: none; }
.card-row:first-child { padding-top: 0; }
.card-row-title { font-size: 30rpx; font-weight: 600; color: var(--ink); letter-spacing: -0.2rpx; }
.card-row-sub { margin-top: 6rpx; font-size: 24rpx; color: var(--ink-3); }

/* ---------------- 按钮（网页版：墨色主按钮 + 描边次按钮） ---------------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 36rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: -0.2rpx;
  border: none;
  box-sizing: border-box;
}
.btn::after { border: none; }
.btn-ink { background: #1a1a1a; color: #fff; }
.btn-accent { background: var(--accent); color: #fff; }
.btn-outline { background: var(--surface); color: var(--ink); border: 1rpx solid var(--border); }
.btn-ghost { background: transparent; color: var(--ink-2); }
.btn-danger { background: var(--bad-wash); color: var(--bad); }
.btn-block { display: flex; width: 100%; }
.btn-sm { height: 64rpx; padding: 0 26rpx; font-size: 25rpx; border-radius: 18rpx; }
.btn-xs { height: 52rpx; padding: 0 20rpx; font-size: 22rpx; border-radius: 14rpx; }
.btn.disabled { opacity: 0.35; }
.tap-dim { opacity: 0.6; }

.link { font-size: 26rpx; font-weight: 600; color: var(--accent); }

/* ---------------- 徽标 ---------------- */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
}
.badge-dim { background: var(--surface-2); color: var(--ink-2); }
.badge-accent { background: var(--accent-wash); color: var(--accent); }
.badge-ok { background: var(--ok-wash); color: var(--ok); }
.badge-warn { background: var(--warn-wash); color: var(--warn); }
.badge-bad { background: var(--bad-wash); color: var(--bad); }
.badge-ink { background: #1a1a1a; color: #fff; }

.dot { width: 12rpx; height: 12rpx; border-radius: 50%; display: inline-block; flex-shrink: 0; }
.dot-ok { background: var(--ok); }
.dot-warn { background: var(--warn); }
.dot-bad { background: var(--bad); }
.dot-accent { background: var(--accent); }
.dot-idle { background: var(--faint); }

/* ---------------- 表单 ---------------- */
.field-label {
  display: block;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--ink-2);
  margin-bottom: 12rpx;
}
.input {
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 20rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  font-size: 29rpx;
  color: var(--ink);
  box-sizing: border-box;
}
.area {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  font-size: 29rpx;
  line-height: 1.7;
  color: var(--ink);
  box-sizing: border-box;
}
.ph { color: var(--placeholder); }

/* ---------------- 进度 ---------------- */
.progress { height: 8rpx; border-radius: 999rpx; background: var(--track); overflow: hidden; }
.progress-fill { height: 100%; border-radius: 999rpx; background: var(--accent); }
.progress-fill-ink { background: #1a1a1a; }

/* ---------------- 头像（对齐网页版 PersonaAvatar：真实照片 + 圆角 + 发丝边） ---------------- */
.avatar {
  border-radius: 18rpx;
  border: 1rpx solid var(--border);
  background: var(--surface-2);
  overflow: hidden;
  flex-shrink: 0;
  display: block;
}
.avatar-img { width: 100%; height: 100%; display: block; }
.avatar-fallback {
  border-radius: 18rpx;
  background: #1d1d1f;
  color: #fff;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.avatar-round { border-radius: 50%; }

/* ---------------- 对话 ---------------- */
.chat { padding: 8rpx 0 24rpx; }
.msg { margin: 20rpx 0; display: flex; }
.msg-out { justify-content: flex-end; }
.bubble {
  max-width: 80%;
  padding: 20rpx 28rpx;
  border-radius: 28rpx;
  font-size: 30rpx;
  line-height: 1.65;
  word-break: break-word;
  box-sizing: border-box;
}
.msg-out .bubble { background: #1a1a1a; color: #fff; border-bottom-right-radius: 8rpx; }
.msg-in .bubble { background: var(--surface); color: var(--ink); border: 1rpx solid var(--border); border-bottom-left-radius: 8rpx; }
.msg-name { font-size: 21rpx; font-weight: 600; color: var(--ink-3); margin: 0 0 10rpx 4rpx; }
.caret {
  display: inline-block;
  width: 3rpx;
  height: 30rpx;
  background: var(--ink);
  vertical-align: -4rpx;
  margin-left: 4rpx;
  animation: caret-blink 1s step-end infinite;
}
@keyframes caret-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
.thinking { font-size: 24rpx; color: var(--ink-3); }

.composer {
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  border-top: 1rpx solid var(--border);
  box-sizing: border-box;
}
.composer-field {
  flex: 1;
  min-height: 76rpx;
  max-height: 240rpx;
  padding: 18rpx 26rpx;
  border-radius: 999rpx;
  background: var(--surface-2);
  font-size: 29rpx;
  line-height: 1.5;
  box-sizing: border-box;
}
.composer-send {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #1a1a1a;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
}
.composer-send.disabled { opacity: 0.28; }

.toolbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 32rpx calc(14rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  border-top: 1rpx solid var(--border);
}
.tool-btn {
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: var(--surface-2);
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-2);
  display: flex;
  align-items: center;
}

/* ---------------- 空态 ---------------- */
.empty { padding: 100rpx 56rpx; text-align: center; }
.empty-title { font-size: 31rpx; font-weight: 600; color: var(--ink-2); }
.empty-sub { margin-top: 12rpx; font-size: 25rpx; line-height: 1.6; color: var(--ink-3); }

/* ---------------- 底部弹层 ---------------- */
.mask { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.32); z-index: 900; }
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 901;
  background: var(--surface);
  border-radius: 36rpx 36rpx 0 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1), 0 30rpx 80rpx rgba(0, 0, 0, 0.24);
  padding: 20rpx 0 calc(24rpx + env(safe-area-inset-bottom));
  max-height: 76vh;
  display: flex;
  flex-direction: column;
}
.sheet-grip {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--faint);
  margin: 0 auto 20rpx;
  flex-shrink: 0;
}
.sheet-title {
  padding: 0 32rpx 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -0.6rpx;
  color: var(--ink);
}
.sheet-scroll { flex: 1; min-height: 0; }
.sheet-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid var(--border);
}
.sheet-item:first-child { border-top: none; }

.segmented {
  display: flex;
  gap: 6rpx;
  padding: 6rpx;
  border-radius: 999rpx;
  background: var(--surface-2);
}
.segmented-item {
  flex: 1;
  height: 64rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-2);
}
.segmented-item-on {
  background: var(--surface);
  color: var(--ink);
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.1);
}

/* ============================================================
 * Markdown（wxml/md.wxml；行内样式由 utils/md.js 注入）
 * ============================================================ */
.md-h { margin: 40rpx 0 14rpx; }
.md-h1 { font-size: 40rpx; line-height: 1.3; font-weight: 700; letter-spacing: -1rpx; }
.md-h2 { font-size: 36rpx; line-height: 1.35; font-weight: 700; letter-spacing: -0.7rpx; }
.md-h3 { font-size: 32rpx; line-height: 1.4; font-weight: 600; letter-spacing: -0.3rpx; }
.md-h4 { font-size: 30rpx; line-height: 1.45; font-weight: 600; color: var(--ink-2); }
.md-p { margin: 16rpx 0; font-size: 30rpx; line-height: 1.8; letter-spacing: -0.1rpx; color: var(--ink); }
.md-quote {
  margin: 22rpx 0;
  padding: 4rpx 0 4rpx 24rpx;
  border-left: 5rpx solid var(--accent-wash);
  color: var(--ink-2);
  font-size: 28rpx;
  line-height: 1.75;
}
.md-list { margin: 16rpx 0; }
.md-li { display: flex; margin: 10rpx 0; gap: 16rpx; }
.md-li-mark { color: var(--ink-3); font-weight: 700; flex-shrink: 0; min-width: 22rpx; }
.md-li-body { flex: 1; min-width: 0; font-size: 30rpx; line-height: 1.8; color: var(--ink); }
.md-hr { margin: 32rpx 0; height: 1rpx; background: var(--border); }
.md-table { margin: 22rpx 0; border-top: 1rpx solid var(--border); }
.md-tr { display: flex; border-bottom: 1rpx solid var(--border); }
.md-td { flex: 1; padding: 16rpx 16rpx 16rpx 0; font-size: 26rpx; line-height: 1.6; min-width: 0; }
.md-code { margin: 22rpx 0; background: #1a1a1a; border-radius: 24rpx; overflow: hidden; }
.md-code-head { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 26rpx 0; }
.md-code-lang { color: #86868b; font-size: 21rpx; letter-spacing: 0.4rpx; }
.md-code-copy { color: #aeaeb2; font-size: 22rpx; font-weight: 600; padding: 6rpx 18rpx; border: 1rpx solid rgba(255, 255, 255, 0.16); border-radius: 999rpx; }
.md-code-scroll { padding: 16rpx 26rpx 24rpx; }
.md-code-text {
  color: #e8e8ed;
  font-family: ui-monospace, Menlo, monospace;
  font-size: 24rpx;
  line-height: 1.65;
  white-space: pre;
}
