<import src="../../wxml/md.wxml" />

<view wx:if="{{book}}" class="book-page">
  <!-- 顶部：书名 + 章节 -->
  <view class="book-head">
    <view class="between">
      <view class="flex-1">
        <view class="book-name">{{book.title}}</view>
        <view wx:if="{{book.author}}" class="book-by">{{book.author}}</view>
      </view>
      <text class="link-action" bindtap="toggleChapters">{{showChapters ? "收起" : "目录"}}</text>
    </view>
    <view wx:if="{{chapter}}" class="focus-q">
      <text class="micro">带读问题</text>
      <view class="focus-q-text">{{chapter.focusQuestion}}</view>
    </view>
  </view>

  <!-- 章节抽屉 -->
  <block wx:if="{{showChapters}}">
    <view class="mask" bindtap="toggleChapters"></view>
    <view class="sheet">
      <view class="sheet-grip"></view>
      <scroll-view scroll-y class="sheet-scroll">
        <view class="sheet-title">目录</view>
        <view wx:for="{{chapters}}" wx:key="id" class="chap {{item.status === 'done' ? 'chap-done' : ''}}" data-id="{{item.id}}" bindtap="pickChapter" hover-class="tap-dim">
          <text class="chap-idx num">{{item.index}}</text>
          <text class="flex-1 chap-title">{{item.title}}</text>
          <view class="dot {{item.status === 'done' ? 'dot-ok' : 'dot-idle'}}"></view>
        </view>
      </scroll-view>
    </view>
  </block>

  <!-- 对话 -->
  <scroll-view scroll-y class="chat-scroll">
    <view class="chat">
      <view wx:if="{{chatView.length === 0 && !busy}}" class="blank">
        <view class="blank-title">开始读</view>
        <view class="blank-sub">{{mode.hint}}</view>
      </view>

      <view wx:for="{{chatView}}" wx:key="index" class="msg {{item.role === 'user' ? 'msg-user' : 'msg-ai'}}">
        <view wx:if="{{item.role === 'user'}}" class="bubble">{{item.content}}</view>
        <block wx:else>
          <template is="md-blocks" data="{{blocks: item.blocks}}" />
        </block>
      </view>

      <view wx:if="{{busy}}" class="msg msg-ai">
        <template is="md-blocks" data="{{blocks: streamBlocks}}" />
        <view class="row" style="margin-top: 12rpx; gap: 12rpx">
          <view class="caret"></view>
          <text class="thinking">{{mode.label}}</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 模式菜单 -->
  <block wx:if="{{showModes}}">
    <view class="mask" bindtap="toggleModes"></view>
    <view class="sheet">
      <view class="sheet-grip"></view>
      <view class="sheet-title">怎么读</view>
      <view wx:for="{{modes}}" wx:key="id" class="mode" data-id="{{item.id}}" bindtap="pickMode" hover-class="tap-dim">
        <view class="between">
          <text class="mode-name {{mode.id === item.id ? 'accent' : ''}}">{{item.label}}</text>
          <text wx:if="{{mode.id === item.id}}" class="accent" style="font-size: 26rpx">使用中</text>
        </view>
        <view class="mode-hint">{{item.hint}}</view>
      </view>
    </view>
  </block>

  <!-- 输入条 -->
  <view class="book-composer">
    <view class="book-composer-inner">
      <view class="mode-chip" bindtap="toggleModes">{{mode.label}}</view>
      <input class="composer-input" placeholder="说点什么" placeholder-class="ph" value="{{input}}" confirm-hold bindinput="onInput" bindconfirm="send" disabled="{{busy}}" />
      <view class="composer-send {{input && !busy ? '' : 'disabled'}}" bindtap="{{input && !busy ? 'send' : ''}}">↑</view>
    </view>
  </view>
</view>

<view wx:else class="blank">
  <view class="blank-title">书不存在</view>
</view>
