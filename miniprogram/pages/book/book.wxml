<import src="../../wxml/md.wxml" />

<nav-bar title="{{book ? book.title : '读书'}}" />

<view wx:if="{{book}}" class="book-page" style="--nav-h: {{navH || '64px'}}">
  <!-- 当前章节 + 带读问题：一行上下文，不是一整块页头 -->
  <view class="book-head">
    <view class="between" bindtap="toggleChapters">
      <view class="flex-1 min-w-0">
        <view class="row gap-8">
          <text class="meta num">{{chapter ? "第 " + chapter.index + " 章" : "全部读完"}}</text>
          <text class="meta">·</text>
          <text class="meta num">{{doneCount}}/{{chapters.length}}</text>
        </view>
        <view class="chap-cur ellipsis">{{chapter ? chapter.title : book.title}}</view>
      </view>
      <view class="chev chev-down">›</view>
    </view>
    <view wx:if="{{chapter}}" class="focus-q">
      <text class="tiny">带着这个问题读</text>
      <view class="focus-q-text">{{chapter.focusQuestion}}</view>
    </view>
  </view>

  <!-- 目录弹层 -->
  <block wx:if="{{showChapters}}">
    <view class="mask" bindtap="toggleChapters"></view>
    <view class="sheet">
      <view class="sheet-grip"></view>
      <view class="sheet-title">目录</view>
      <scroll-view scroll-y class="sheet-scroll">
        <view
          wx:for="{{chapters}}"
          wx:key="id"
          class="sheet-item {{item.status === 'done' ? 'chap-done' : ''}}"
          data-id="{{item.id}}"
          bindtap="pickChapter"
        >
          <text class="chap-idx num">{{item.index}}</text>
          <text class="flex-1 chap-title">{{item.title}}</text>
          <view wx:if="{{item.status === 'done'}}" class="badge badge-ok">已读</view>
          <view wx:elif="{{chapter && chapter.id === item.id}}" class="badge badge-accent">在读</view>
        </view>
      </scroll-view>
    </view>
  </block>

  <!-- 对话 -->
  <scroll-view scroll-y class="chat-scroll" scroll-into-view="{{toBottom}}" scroll-with-animation>
    <view class="chat">
      <view wx:if="{{chatView.length === 0 && !busy}}" class="empty">
        <view class="empty-title">开始读</view>
        <view class="empty-sub">{{mode.hint}}</view>
      </view>
      <view wx:for="{{chatView}}" wx:key="index" class="msg {{item.role === 'user' ? 'msg-out' : 'msg-in'}}">
        <view wx:if="{{item.role === 'user'}}" class="bubble">{{item.content}}</view>
        <view wx:else class="card-flat" style="max-width: 100%">
          <template is="md-blocks" data="{{blocks: item.blocks}}" />
        </view>
      </view>
      <view wx:if="{{busy}}" class="msg msg-in">
        <view class="card-flat" style="max-width: 100%">
          <template is="md-blocks" data="{{blocks: streamBlocks}}" />
          <view class="row gap-8" style="margin-top: 10rpx">
            <view class="caret"></view>
            <text class="thinking">{{mode.label}}</text>
          </view>
        </view>
      </view>
      <view id="chat-bottom" style="height: 2rpx"></view>
    </view>
  </scroll-view>

  <!-- 读法选择 -->
  <block wx:if="{{showModes}}">
    <view class="mask" bindtap="toggleModes"></view>
    <view class="sheet">
      <view class="sheet-grip"></view>
      <view class="sheet-title">怎么读</view>
      <scroll-view scroll-y class="sheet-scroll">
        <view wx:for="{{modes}}" wx:key="id" class="sheet-item" data-id="{{item.id}}" bindtap="pickMode">
          <view class="flex-1">
            <view class="row gap-12">
              <text class="mode-name {{mode.id === item.id ? 'accent-text' : ''}}">{{item.label}}</text>
              <view wx:if="{{mode.id === item.id}}" class="badge badge-accent">使用中</view>
            </view>
            <view class="mode-hint">{{item.hint}}</view>
          </view>
        </view>
      </scroll-view>
    </view>
  </block>

  <view class="composer">
    <view class="mode-btn" bindtap="toggleModes">{{mode.label}}</view>
    <input
      class="composer-field"
      placeholder="说说你的理解，或反驳"
      placeholder-class="ph"
      value="{{input}}"
      confirm-hold
      bindinput="onInput"
      bindconfirm="send"
      disabled="{{busy}}"
    />
    <view class="composer-send {{input && !busy ? '' : 'disabled'}}" bindtap="{{input && !busy ? 'send' : ''}}">↑</view>
  </view>
</view>

<view wx:else class="page">
  <view class="empty">
    <view class="empty-title">书不存在</view>
  </view>
</view>
