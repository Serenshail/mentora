/* 读书页：全屏对话。
 * 结构 = 顶部章节上下文（可点开目录）+ 对话滚动区 + 底部输入条。
 * 章节和模式都收进底部弹层，不再常驻占据一栏——手机上一栏就是半屏。 */

.book-page {
  /* 页面高度 = 视口 - 真实导航高度（由 nav-bar 组件回写的 --nav-h）。
   * 写死 100vh 会让内容被导航栏顶下去一截。 */
  height: calc(100vh - var(--nav-h, 64px));
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: var(--bg);
}

/* 顶部章节条：两行信息（进度 + 章节名），再加一个带读问题 */
.book-head {
  flex-shrink: 0;
  padding: 12rpx 32rpx 20rpx;
  background: var(--bg);
  border-bottom: 1rpx solid var(--border);
}
.chap-cur {
  margin-top: 2rpx;
  font-size: 29rpx;
  font-weight: 600;
  letter-spacing: -0.2rpx;
  color: var(--ink);
  max-width: 100%;
}
.chev {
  color: var(--faint);
  font-size: 32rpx;
  line-height: 1;
  flex-shrink: 0;
}
.chev-down { transform: rotate(90deg); }

.focus-q {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: var(--accent-wash);
}
.focus-q-text {
  margin-top: 4rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--ink);
}

.chat-scroll {
  flex: 1;
  min-height: 0;
  padding: 0 32rpx;
}

/* 已读章节降低视觉权重，但不消失（要能回看） */
.chap-done { opacity: 0.52; }
.chap-idx {
  width: 44rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--ink-3);
  flex-shrink: 0;
}
.chap-title {
  font-size: 29rpx;
  line-height: 1.5;
  color: var(--ink);
}

.mode-name { font-size: 30rpx; font-weight: 600; color: var(--ink); }
.mode-hint { margin-top: 6rpx; font-size: 24rpx; line-height: 1.55; color: var(--ink-3); }

/* 读法按钮：比输入框矮一档，明确是"次要控件" */
.mode-btn {
  height: 80rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--surface-2);
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-2);
  display: flex;
  align-items: center;
  flex-shrink: 0;
  max-width: 220rpx;
}

/* ============ 阅读系统 V1.0：概览 / 验收 / 沉淀 ============ */

/* 认知概览：收起时只有一行状态条，展开是地图+目标+状态机 */
.overview {
  flex-shrink: 0;
  max-height: 46vh;
  border-bottom: 1rpx solid var(--border);
  background: var(--bg);
}
.ov-sec {
  padding: 22rpx 32rpx;
  border-bottom: 1rpx solid var(--border);
}
.ov-item { margin-top: 14rpx; }

/* 目标 chips：主目标实底、次目标描边、未选中灰 */
.chip {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--border);
  font-size: 24rpx;
  color: var(--ink-3);
  background: var(--bg);
  flex-shrink: 0;
}
.chip-on {
  background: var(--ink);
  border-color: var(--ink);
  color: #fff;
  font-weight: 600;
}
.chip-sec {
  border-color: var(--accent);
  color: var(--accent);
  background: var(--accent-wash);
}

/* 本章快捷操作条：三个等权入口，输入条上方 */
.chapter-actions {
  flex-shrink: 0;
  padding: 10rpx 24rpx 4rpx;
  background: var(--bg);
}

/* 全屏层（验收/小结）：比 sheet 更大的一块工作面，题目和长文需要空间 */
.layer {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 60;
  background: var(--bg);
  display: flex;
  flex-direction: column;
  padding: calc(var(--nav-h, 64px) + 12rpx) 0 0;
}
.layer-panel {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 0 32rpx;
}
.layer-scroll {
  flex: 1;
  min-height: 0;
}

/* 验收题干 / 证据（与 day 页同款，本页此前没有） */
.acc-q {
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.55;
  color: var(--ink);
}
.evidence {
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: var(--surface-2);
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--ink-3);
}
