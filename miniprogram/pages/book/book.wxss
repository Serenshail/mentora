.chapter-list { margin-top: 16rpx; border-top: 1rpx solid var(--border); }
.chapter-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.chapter-row:last-child { border-bottom: none; }
.chapter-done { opacity: 0.55; }
.chapter-title { flex: 1; min-width: 0; font-size: 27rpx; color: var(--ink); }
.chapter-focus {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  background: var(--accent-soft);
  border-radius: 16rpx;
}
.chat-zone { margin-top: 20rpx; }
.chat-row { display: flex; margin: 16rpx 0; }
.chat-right { justify-content: flex-end; }
.ai-card { max-width: 100%; }
.composer-zone {
  margin-top: 12rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
.mode-menu {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08), 0 24rpx 64rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 14rpx;
  padding: 8rpx 24rpx;
}
.mode-item { padding: 18rpx 0; border-bottom: 1rpx solid var(--border); }
.mode-item:last-child { border-bottom: none; }
.mode-name { font-size: 28rpx; font-weight: 700; color: var(--ink); }
.composer { display: flex; gap: 12rpx; align-items: center; }
.composer-input { flex: 1; }
.mode-btn { flex-shrink: 0; }
