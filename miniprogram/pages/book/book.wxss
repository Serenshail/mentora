.book-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.book-head {
  padding: 20rpx 36rpx 24rpx;
  border-bottom: 1rpx solid var(--hairline);
  flex-shrink: 0;
}
.book-name {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -1.2rpx;
  line-height: 1.3;
  color: var(--ink);
}
.book-by { margin-top: 6rpx; font-size: 24rpx; color: var(--ink-3); }
.focus-q { margin-top: 22rpx; }
.focus-q-text {
  margin-top: 8rpx;
  font-size: 27rpx;
  line-height: 1.6;
  color: var(--ink-2);
}

.chat-scroll { flex: 1; min-height: 0; padding: 0 36rpx; }
.ph { color: #b8bcc4; }

.sheet-title {
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 1.2rpx;
  color: var(--ink-3);
  padding: 6rpx 0 18rpx;
}
.chap {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--hairline);
}
.chap-done { opacity: 0.5; }
.chap-idx { width: 40rpx; font-size: 23rpx; color: var(--ink-3); flex-shrink: 0; }
.chap-title { font-size: 29rpx; line-height: 1.5; color: var(--ink); }
.mode { padding: 26rpx 0; border-bottom: 1rpx solid var(--hairline); }
.mode:last-child { border-bottom: none; }
.mode-name { font-size: 30rpx; font-weight: 600; color: var(--ink); }
.mode-hint { margin-top: 8rpx; font-size: 24rpx; line-height: 1.55; color: var(--ink-3); }

.book-composer {
  flex-shrink: 0;
  background: var(--paper);
  border-top: 1rpx solid var(--hairline);
}
.book-composer-inner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
}
.mode-chip {
  flex-shrink: 0;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: var(--wash);
  font-size: 23rpx;
  font-weight: 600;
  color: var(--ink-2);
}
