.book-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: var(--bg);
}
.book-head {
  flex-shrink: 0;
  padding: 24rpx 32rpx 24rpx;
  background: var(--bg);
  border-bottom: 1rpx solid var(--border);
}
.focus-q {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: var(--accent-wash);
}
.focus-q-text { margin-top: 8rpx; font-size: 27rpx; line-height: 1.55; color: var(--ink); }
.chat-scroll { flex: 1; min-height: 0; padding: 0 32rpx; }
.chap-done { opacity: 0.5; }
.chap-idx { width: 40rpx; font-size: 23rpx; color: var(--ink-3); flex-shrink: 0; }
.chap-title { font-size: 29rpx; line-height: 1.5; color: var(--ink); }
.mode-name { font-size: 30rpx; font-weight: 600; color: var(--ink); }
.mode-hint { margin-top: 8rpx; font-size: 24rpx; line-height: 1.55; color: var(--ink-3); }
