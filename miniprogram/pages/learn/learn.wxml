<view class="page-pad safe-bottom">
  <view class="row-between" style="margin-bottom: 20rpx">
    <view class="h1">学习教练</view>
    <view class="dim small">{{syncHint}}</view>
  </view>

  <view wx:if="{{goals.length === 0 && !loading}}" class="card empty-card">
    <view class="empty-title">还没有学习目标</view>
    <view class="dim small">网页端完成苏格拉底引导后会同步到这里；也可以先用示例目标体验闭环</view>
    <button class="btn btn-outline btn-sm" style="margin-top: 24rpx" bindtap="seedSample">用示例目标试一试</button>
  </view>

  <view
    wx:for="{{goals}}"
    wx:key="id"
    class="card section-gap {{item.active ? 'goal-active' : ''}}"
    data-id="{{item.id}}"
    bindtap="openGoal"
    hover-class="btn-tap"
  >
    <view class="row-between wrap" style="gap: 12rpx">
      <view class="badge badge-{{item.statusTone}}">{{item.statusLabel}}</view>
      <view class="dim3 small num">Day 通过 {{item.passed}}/{{item.total}}</view>
    </view>
    <view class="h2" style="margin-top: 14rpx">{{item.topic}}</view>
    <view class="dim small goal-dir" wx:if="{{item.direction}}">{{item.direction}}</view>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{item.progress}}%"></view>
    </view>
  </view>
</view>
