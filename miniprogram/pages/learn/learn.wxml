<view class="page">
  <view class="page-head">
    <view class="title">学习</view>
    <text wx:if="{{syncHint}}" class="micro">{{syncHint}}</text>
  </view>

  <view wx:if="{{goals.length === 0 && !loading}}" class="blank">
    <view class="blank-title">还没有目标</view>
    <view class="blank-sub">在网页端做完苏格拉底引导，这里就会出现。\n想先看看长什么样，用示例目标。</view>
    <button class="btn btn-outline btn-sm" style="margin-top: 40rpx; display: inline-flex" bindtap="seedSample">
      用示例目标试一试
    </button>
  </view>

  <view wx:for="{{goals}}" wx:key="id">
    <view class="goal" data-id="{{item.id}}" bindtap="openGoal" hover-class="tap-dim">
      <view class="goal-top">
        <view class="row gap-12">
          <view class="dot dot-{{item.statusTone}}"></view>
          <text class="goal-status">{{item.statusLabel}}</text>
        </view>
        <text class="micro num">{{item.passed}}/{{item.total}} 天</text>
      </view>
      <view class="goal-topic">{{item.topic}}</view>
      <view wx:if="{{item.direction}}" class="goal-dir">{{item.direction}}</view>
      <view class="bar" style="margin-top: 26rpx">
        <view class="bar-fill {{item.active ? 'bar-fill-accent' : ''}}" style="width: {{item.progress}}%"></view>
      </view>
    </view>
  </view>
</view>
