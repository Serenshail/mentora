.goal-active { border-color: rgba(91, 84, 230, 0.3); }
.goal-dir {
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.progress-track {
  margin-top: 20rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: var(--track);
  overflow: hidden;
}
.progress-fill { height: 100%; border-radius: 999rpx; background: var(--accent); }
.empty-card { border-style: dashed; }
