.goal { border-color: rgba(91, 84, 230, 0.22); }
.goal-topic { margin-top: 16rpx; }
.goal-dir {
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.goal-next {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--border);
}
.goal-day {
  margin-top: 6rpx;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.45;
  color: var(--ink);
}
.review { display: flex; align-items: center; gap: 20rpx; border-color: rgba(4, 120, 87, 0.22); }

.heat-scroll { width: 100%; white-space: nowrap; }
.heat { display: flex; gap: 7rpx; }
.heat-col { display: flex; flex-direction: column; gap: 7rpx; }
.heat-cell { width: 20rpx; height: 20rpx; border-radius: 5rpx; background: var(--track); }
.heat-0 { background: var(--track); }
.heat-1 { background: rgba(91, 84, 230, 0.2); }
.heat-2 { background: rgba(91, 84, 230, 0.5); }
.heat-3 { background: var(--accent); }
.heat-off { opacity: 0.3; }

.entries { padding: 0 32rpx; }
.entry {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.entry:last-child { border-bottom: none; }
.entry-img {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  border: 1rpx solid var(--border);
  background: var(--surface-2);
  flex-shrink: 0;
}
.chev { color: var(--faint); font-size: 30rpx; }
