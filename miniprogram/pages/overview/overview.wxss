.goal-card { border-color: rgba(91, 84, 230, 0.25); }
.goal-topic { margin-top: 16rpx; }
.goal-dir {
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.goal-progress-track {
  margin-top: 20rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: var(--track);
  overflow: hidden;
}
.goal-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--accent);
}
.goal-today {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--border);
}
.strong-line { font-weight: 600; color: var(--ink); }
.empty-card { border-style: dashed; }

.review-card { border-color: rgba(4, 120, 87, 0.25); }

.heat-scroll { margin-top: 18rpx; width: 100%; }
.heat-row { display: flex; flex-direction: row; }
.heat-col { display: flex; flex-direction: column; margin-right: 8rpx; }
.heat-cell {
  width: 20rpx;
  height: 20rpx;
  border-radius: 5rpx;
  margin-bottom: 8rpx;
  background: var(--track);
}
.heat-0 { background: var(--track); }
.heat-1 { background: #c7d2d0; }
.heat-2 { background: #6ee7b7; }
.heat-3 { background: var(--ok); }
.heat-future { opacity: 0.35; }
