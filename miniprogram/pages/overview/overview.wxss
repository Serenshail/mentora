.ov-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 20rpx 0 40rpx;
}
.greet {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -1.8rpx;
  line-height: 1.1;
  color: var(--ink);
  max-width: 460rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.streak { text-align: right; }
.streak-num { font-size: 40rpx; font-weight: 700; color: var(--ink); letter-spacing: -1rpx; }
.streak-unit { font-size: 22rpx; color: var(--ink-3); margin-left: 6rpx; }

/* 焦点目标 */
.focus {
  border: 1.5rpx solid var(--hairline);
  border-radius: 34rpx;
  padding: 36rpx;
}
.focus-top { display: flex; align-items: center; justify-content: space-between; }
.focus-topic {
  margin-top: 22rpx;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: -1.4rpx;
  line-height: 1.3;
  color: var(--ink);
}
.focus-dir {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--ink-3);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.focus-next {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 30rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--hairline);
}
.focus-day {
  margin-top: 6rpx;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.45;
  color: var(--ink);
}

.blank-start { padding: 80rpx 0; text-align: center; }

/* 复习行 */
.review-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 32rpx;
  padding: 26rpx 30rpx;
  border-radius: 24rpx;
  background: var(--warn-wash);
  font-size: 28rpx;
}

.heat-scroll { width: 100%; }
