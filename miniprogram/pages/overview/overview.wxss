/* 今天页：一屏只回答"现在该做什么"。
 * 主卡是墨色 hero（唯一），复习是带强调边的白卡，其余全是纯排版。 */

.due {
  margin-top: 20rpx;
  border-color: rgba(91, 84, 230, 0.22);
}
.due-num {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1;
  color: var(--accent);
  flex-shrink: 0;
  min-width: 76rpx;
}

/* hero 内部的小箭头：用 CSS 画，避免为一个小图标引入资源 */
.hero-btn-chev {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #1a1a1a;
  border-top: 3rpx solid #1a1a1a;
  transform: rotate(45deg);
  border-radius: 1rpx;
}
