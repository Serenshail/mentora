<view class="page">
  <view class="ov-head">
    <view class="greet">{{name ? name : "你好"}}</view>
    <view wx:if="{{streakDays > 0}}" class="streak">
      <text class="streak-num num">{{streakDays}}</text>
      <text class="streak-unit">天连续</text>
    </view>
  </view>

  <!-- 当前目标：唯一的"形" -->
  <view wx:if="{{goal}}" class="focus" bindtap="goToday" hover-class="tap-dim">
    <view class="focus-top">
      <view class="eyebrow" style="color: var(--accent)"><view class="eyebrow-mark"></view><text>进行中</text></view>
      <text class="micro num">{{goal.progress}}%</text>
    </view>
    <view class="focus-topic">{{goal.topic}}</view>
    <view class="focus-dir">{{goal.direction}}</view>
    <view class="bar" style="margin-top: 30rpx">
      <view class="bar-fill bar-fill-accent" style="width: {{goal.progress}}%"></view>
    </view>
    <view wx:if="{{goal.dayTitle}}" class="focus-next">
      <view class="flex-1">
        <view class="micro">{{goal.gated ? "还差一道迁移题" : goal.phaseTitle}}</view>
        <view class="focus-day">{{goal.dayTitle}}</view>
      </view>
      <view class="btn btn-ink btn-sm">继续</view>
    </view>
  </view>

  <view wx:elif="{{!loading}}" class="blank-start" bindtap="goLearn" hover-class="tap-dim">
    <view class="blank-title">还没开始</view>
    <view class="blank-sub">在网页端做完引导，或者直接点这里看学习页</view>
  </view>

  <!-- 复习：一行就够，不做卡 -->
  <view wx:if="{{dueCount > 0}}" class="review-line" bindtap="goReview" hover-class="tap-dim">
    <view class="dot dot-warn"></view>
    <view class="flex-1">
      <text class="strong">{{dueCount}} 条到期</text>
      <text class="ink-3" style="font-size: 26rpx"> 该复习了</text>
    </view>
    <text class="link-action">开始</text>
  </view>

  <!-- 热力 -->
  <view class="sec">
    <view class="between" style="margin-bottom: 22rpx">
      <view class="eyebrow"><view class="eyebrow-mark"></view><text>近 12 周</text></view>
      <text class="micro">验收质量</text>
    </view>
    <scroll-view scroll-x class="heat-scroll">
      <view class="heat">
        <view wx:for="{{heatCols}}" wx:key="index" class="heat-col">
          <view
            wx:for="{{item}}"
            wx:for-item="cell"
            wx:key="date"
            class="heat-cell heat-{{cell.level}} {{cell.future ? 'heat-future' : ''}}"
          ></view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 四个去处：纯列表 -->
  <view class="sec">
    <view class="eyebrow"><view class="eyebrow-mark"></view><text>去哪</text></view>
    <view style="margin-top: 6rpx">
      <view class="line" bindtap="goLearn" hover-class="tap-dim">
        <view class="flex-1">
          <view class="line-title">学习教练</view>
          <view class="line-sub">计划、讲义、验收</view>
        </view>
        <text class="chev">›</text>
      </view>
      <view class="line" bindtap="goBrain" hover-class="tap-dim">
        <view class="flex-1">
          <view class="line-title">第二大脑</view>
          <view class="line-sub">{{counts.notes}} 篇笔记</view>
        </view>
        <text class="chev">›</text>
      </view>
      <view class="line" bindtap="goRead" hover-class="tap-dim">
        <view class="flex-1">
          <view class="line-title">读书伙伴</view>
          <view class="line-sub">{{counts.books}} 本在架</view>
        </view>
        <text class="chev">›</text>
      </view>
      <view class="line" bindtap="goCouncil" hover-class="tap-dim">
        <view class="flex-1">
          <view class="line-title">人生伙伴</view>
          <view class="line-sub">单聊与圆桌</view>
        </view>
        <text class="chev">›</text>
      </view>
    </view>
  </view>
</view>
