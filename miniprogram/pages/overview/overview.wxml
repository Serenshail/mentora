<view class="page">
  <view class="page-head">
    <view class="page-head-title">继续。</view>
    <view class="page-head-sub">{{name}}{{sync ? " · " + sync : ""}}</view>
  </view>

  <view wx:if="{{goal}}" class="card goal" bindtap="goToday" hover-class="tap-dim">
    <view class="between">
      <view class="badge badge-accent row gap-8">
        <view class="dot dot-accent"></view>进行中
      </view>
      <text class="meta num">{{goal.progress}}%</text>
    </view>
    <view class="h2 goal-topic">{{goal.topic}}</view>
    <view wx:if="{{goal.direction}}" class="goal-dir">{{goal.direction}}</view>
    <view class="progress" style="margin-top: 24rpx">
      <view class="progress-fill" style="width: {{goal.progress}}%"></view>
    </view>
    <view wx:if="{{goal.dayTitle}}" class="goal-next">
      <view class="flex-1">
        <view class="meta">{{goal.gated ? "还差一道迁移题" : goal.phaseTitle}}</view>
        <view class="goal-day">{{goal.dayTitle}}</view>
      </view>
      <view class="btn btn-ink btn-sm">继续学</view>
    </view>
  </view>

  <view wx:elif="{{!loading}}" class="card" bindtap="goLearn" hover-class="tap-dim">
    <view class="h3">还没有进行中的目标</view>
    <view class="sub" style="margin-top: 8rpx">新建目标在网页端完成引导，小程序同步后继续学</view>
  </view>

  <view wx:if="{{dueCount > 0}}" class="card review" bindtap="goReview" hover-class="tap-dim">
    <view class="flex-1">
      <view class="h3">复习到期 <text class="accent-text num">{{dueCount}}</text> 条</view>
      <view class="sub" style="margin-top: 6rpx">间隔重复：今天不记，明天更贵</view>
    </view>
    <view class="btn btn-accent btn-sm">开始</view>
  </view>

  <view class="card">
    <view class="between" style="margin-bottom: 20rpx">
      <text class="h3">学习热力</text>
      <text class="meta">验收质量 · 近 12 周</text>
    </view>
    <scroll-view scroll-x class="heat-scroll">
      <view class="heat">
        <view wx:for="{{heatCols}}" wx:key="index" class="heat-col">
          <view
            wx:for="{{item}}"
            wx:for-item="cell"
            wx:key="date"
            class="heat-cell heat-{{cell.level}} {{cell.future ? 'heat-off' : ''}}"
          ></view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="card card-tight entries">
    <view class="entry" bindtap="goLearn" hover-class="tap-dim">
      <image class="entry-img" src="/images/personas/naval.jpg" mode="aspectFill" />
      <view class="flex-1">
        <view class="card-row-title">学习教练</view>
        <view class="card-row-sub">计划 · 讲义 · 验收闭环</view>
      </view>
      <view class="chev">›</view>
    </view>
    <view class="entry" bindtap="goBrain" hover-class="tap-dim">
      <image class="entry-img" src="/images/personas/karpathy.jpg" mode="aspectFill" />
      <view class="flex-1">
        <view class="card-row-title">第二大脑</view>
        <view class="card-row-sub">{{counts.notes}} 篇笔记 · 双链网络</view>
      </view>
      <view class="chev">›</view>
    </view>
    <view class="entry" bindtap="goRead" hover-class="tap-dim">
      <image class="entry-img" src="/images/personas/graham.jpg" mode="aspectFill" />
      <view class="flex-1">
        <view class="card-row-title">读书伙伴</view>
        <view class="card-row-sub">{{counts.books}} 本书在架</view>
      </view>
      <view class="chev">›</view>
    </view>
    <view class="entry" bindtap="goCouncil" hover-class="tap-dim">
      <image class="entry-img" src="/images/personas/munger.jpg" mode="aspectFill" />
      <view class="flex-1">
        <view class="card-row-title">人生伙伴</view>
        <view class="card-row-sub">16 席位 · 圆桌会议</view>
      </view>
      <view class="chev">›</view>
    </view>
  </view>
</view>
