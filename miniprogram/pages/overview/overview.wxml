<view class="page-pad safe-bottom">
  <view class="row-between">
    <view>
      <view class="h1">继续。</view>
      <view class="dim small" wx:if="{{name}}">{{name}} · {{sync}}</view>
      <view class="dim small" wx:else>{{sync}}</view>
    </view>
    <view class="badge badge-accent" wx:if="{{streakDays > 0}}">连续 {{streakDays}} 天</view>
  </view>

  <!-- 当前目标 -->
  <view wx:if="{{goal}}" class="card section-gap goal-card" bindtap="goToday" hover-class="btn-tap">
    <view class="row-between">
      <view class="badge badge-accent">进行中</view>
      <view class="dim3 small num">{{goal.progress}}%</view>
    </view>
    <view class="h2 goal-topic">{{goal.topic}}</view>
    <view class="dim small goal-dir">{{goal.direction}}</view>
    <view class="goal-progress-track">
      <view class="goal-progress-fill" style="width: {{goal.progress}}%"></view>
    </view>
    <view wx:if="{{goal.dayTitle}}" class="goal-today row-between">
      <view class="flex-1">
        <view class="tiny dim3">{{goal.gated ? "过关前差一道迁移题" : goal.phaseTitle}}</view>
        <view class="small strong-line">{{goal.dayTitle}}</view>
      </view>
      <view class="btn btn-primary btn-sm">继续学</view>
    </view>
  </view>

  <view wx:elif="{{!loading}}" class="card section-gap empty-card" bindtap="goLearn" hover-class="btn-tap">
    <view class="h3">还没有进行中的目标</view>
    <view class="dim small" style="margin-top: 8rpx">新建目标在网页端完成引导，小程序同步后继续学</view>
  </view>

  <!-- 复习 -->
  <view wx:if="{{dueCount > 0}}" class="card section-gap review-card" bindtap="goReview" hover-class="btn-tap">
    <view class="row-between">
      <view class="flex-1">
        <view class="h3">复习到期 <text class="accent-text num">{{dueCount}}</text> 条</view>
        <view class="dim small" style="margin-top: 6rpx">间隔重复：今天不记，明天更贵</view>
      </view>
      <view class="btn btn-accent btn-sm">开始复习</view>
    </view>
  </view>

  <!-- 热力墙 -->
  <view class="card section-gap">
    <view class="row-between">
      <view class="h3">学习热力</view>
      <view class="dim3 tiny">验收质量 · 近 12 周</view>
    </view>
    <scroll-view scroll-x class="heat-scroll">
      <view class="heat-row">
        <view wx:for="{{heatCols}}" wx:key="index" class="heat-col">
          <view
            wx:for="{{item}}"
            wx:for-item="cell"
            wx:key="date"
            class="heat-cell heat-{{cell.level}} {{cell.future ? 'heat-future' : ''}}"
          ></view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 快捷入口 -->
  <view class="card section-gap">
    <view class="cell" bindtap="goLearn" hover-class="btn-tap">
      <view class="flex-1">
        <view class="cell-title">学习教练</view>
        <view class="cell-sub">计划 · 讲义 · 验收闭环</view>
      </view>
      <view class="cell-arrow">›</view>
    </view>
    <view class="cell" bindtap="goBrain" hover-class="btn-tap">
      <view class="flex-1">
        <view class="cell-title">第二大脑</view>
        <view class="cell-sub">{{counts.notes}} 篇笔记 · 双链网络</view>
      </view>
      <view class="cell-arrow">›</view>
    </view>
    <view class="cell" bindtap="goRead" hover-class="btn-tap">
      <view class="flex-1">
        <view class="cell-title">读书伙伴</view>
        <view class="cell-sub">{{counts.books}} 本书在架</view>
      </view>
      <view class="cell-arrow">›</view>
    </view>
    <view class="cell" bindtap="goCouncil" hover-class="btn-tap">
      <view class="flex-1">
        <view class="cell-title">人生伙伴</view>
        <view class="cell-sub">16 席位单聊与圆桌会议</view>
      </view>
      <view class="cell-arrow">›</view>
    </view>
  </view>
</view>
