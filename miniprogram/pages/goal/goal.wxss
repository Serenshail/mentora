.phase { margin-top: 24rpx; }
.chev { color: var(--faint); font-size: 30rpx; transform: rotate(0deg); transition: transform .18s; }
.chev-open { transform: rotate(90deg); }
.days { margin-top: 20rpx; border-top: 1rpx solid var(--border); }
.day {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.day:last-child { border-bottom: none; }
.day-off { opacity: 0.4; }
.day-idx { width: 40rpx; font-size: 23rpx; color: var(--ink-3); flex-shrink: 0; }
.day-title { font-size: 29rpx; line-height: 1.5; color: var(--ink); }
