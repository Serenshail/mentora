/* 今日任务页：全产品信息量最大的一屏。
 * 层级策略 —— 迁移题真门（如果有）占据墨绿 hero，因为那是"现在唯一该做的事"；
 * 没有真门时，讲义/答疑/验收三段切换是主结构，内容全部收进白卡。 */

/* ===== 迁移题真门（墨绿 hero 内的白卡） ===== */
.gate-box {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.1);
}
.gate-q {
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.7;
  color: #fff;
}
.gate-area {
  margin-top: 18rpx;
  background: #fff;
  min-height: 180rpx;
}

/* ===== 三段切换 =====
 * 不用 position:sticky（WXSS 部分基础库不稳定），
 * 改为普通定位：切换器保持在内文顶部，滚动时随页面一起走。 */
.sticky-seg {
  margin: 8rpx 0 24rpx;
}

/* ===== 讲义 ===== */
.lesson-links {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 22rpx;
  padding: 18rpx 22rpx;
  background: var(--accent-wash);
  border-radius: 18rpx;
}
.less-regen {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border);
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-3);
}

/* ===== 验收 ===== */
.acc-q {
  margin: 14rpx 0 16rpx;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.65;
  color: var(--ink);
}
.grade-q {
  margin: 14rpx 0 10rpx;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.6;
  color: var(--ink);
}
.evidence {
  margin-top: 16rpx;
  padding-left: 20rpx;
  border-left: 4rpx solid var(--border-strong);
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--ink-3);
}
.review-advice {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: var(--accent-wash);
  font-size: 26rpx;
  line-height: 1.65;
  color: var(--accent);
}
.pass-card {
  border-color: rgba(4, 120, 87, 0.3);
}

/* 跳过区：视觉上明确"次要且带后果" */
.skip-zone {
  margin-top: 24rpx;
  border-style: dashed;
}

/* hero 内小箭头 */
.hero-btn-chev {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #1a1a1a;
  border-top: 3rpx solid #1a1a1a;
  transform: rotate(45deg);
  border-radius: 1rpx;
}
