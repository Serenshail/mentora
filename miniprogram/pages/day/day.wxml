<import src="../../wxml/md.wxml" />

<nav-bar title="{{day ? day.title : '今日任务'}}" />

<view wx:if="{{day}}" class="page">
  <!-- ===== 头部：状态 + 标题 + 知识点 ===== -->
  <view class="head">
    <view class="row wrap gap-12">
      <view
        class="badge {{day.status === 'passed' ? 'badge-ok' : day.status === 'skipped' ? 'badge-warn' : 'badge-accent'}}"
      >{{day.status === 'passed' ? '已通过' : day.status === 'skipped' ? '已跳过' : '今日任务'}}</view>
      <view wx:if="{{day.attempts > 0}}" class="badge badge-dim num">验收 {{day.attempts}} 次</view>
      <view wx:if="{{readOnly}}" class="badge badge-dim">回看</view>
    </view>
    <view class="head-title" style="margin-top: 14rpx">{{day.title}}</view>
    <view wx:if="{{day.method}}" class="head-sub">{{day.method}}</view>
    <view wx:if="{{day.kps.length}}" class="row wrap gap-8" style="margin-top: 18rpx">
      <view wx:for="{{day.kps}}" wx:key="*this" class="badge badge-dim">◆ {{item}}</view>
    </view>
  </view>

  <!-- ===== 目录占位：先展开今天的细节，再谈学习 ===== -->
  <view wx:if="{{day.stub}}" class="card" style="margin-top: 24rpx">
    <view class="empty-title">今天的细节还没展开</view>
    <view class="empty-sub">目录只排了标题与知识点。展开后会有：资料、方法、讲义与验收题（约半分钟）。</view>
    <button class="btn btn-ink" style="margin: 32rpx auto 0; width: 70%" bindtap="expandDetail" loading="{{detailBusy}}">
      {{detailBusy ? "正在展开…" : "展开今天的计划"}}
    </button>
  </view>

  <!-- ===== 迁移题真门：这才是现在唯一该做的事 ===== -->
  <!-- 绿底走 ok 色令牌（app.wxss 中定义）：主题/深色模式改造时不再留下孤岛色 -->
  <view wx:if="{{day.pendingUnlock}}" class="hero" style="background: var(--ok)">
    <view class="hero-kicker" style="color: rgba(255,255,255,.7)">
      <view class="dot" style="background: #fff"></view>
      还差最后一步
    </view>
    <view class="hero-title">先合上材料，答一道迁移题</view>
    <view class="hero-sub">判分已经过了，也保存好了。答完这一题，下一天才解锁——这一步不能代劳。</view>
    <view class="gate-box">
      <view class="gate-q">{{gateQuestion || "用你自己的话，把本日核心概念讲给一个没学过的人听，并说明它在什么情况下不适用。"}}</view>
      <textarea
        class="area gate-area"
        placeholder="凭记忆作答（这不是评分，是帮你把知识焊牢）"
        placeholder-class="ph"
        value="{{gateAnswer}}"
        bindinput="onGateInput"
        maxlength="2000"
      />
      <!-- 空答案的提交此前静默 return（无反馈无禁用态）：对齐同页提交评分按钮的
           disabled 视觉态 + bindtap 门控；纯空白输入由 commitTransfer 的 toast 兜住 -->
      <button
        class="btn btn-ink btn-block {{gateAnswer ? '' : 'disabled'}}"
        style="margin-top: 20rpx"
        bindtap="{{gateAnswer ? 'commitTransfer' : ''}}"
        aria-role="button"
        aria-label="{{gateAnswer ? '提交，完成过关' : '先写下你的回答再提交'}}"
      >提交，完成过关</button>
    </view>
  </view>

  <!-- ===== 三段：讲义 / 答疑 / 验收 ===== -->
  <view wx:if="{{!day.stub}}" class="segmented sticky-seg">
    <view
      class="segmented-item {{tab === 'lesson' ? 'segmented-item-on' : ''}}"
      data-tab="lesson"
      bindtap="setTab"
      aria-role="button"
      aria-label="{{tab === 'lesson' ? '当前：讲义' : '讲义'}}"
    >讲义</view>
    <view
      class="segmented-item {{tab === 'qa' ? 'segmented-item-on' : ''}}"
      data-tab="qa"
      bindtap="setTab"
      aria-role="button"
      aria-label="{{tab === 'qa' ? '当前：答疑' : '答疑'}}"
    >答疑</view>
    <view
      class="segmented-item {{tab === 'quiz' ? 'segmented-item-on' : ''}}"
      data-tab="quiz"
      bindtap="setTab"
      aria-role="button"
      aria-label="{{tab === 'quiz' ? '当前：验收' : '验收'}}"
    >验收</view>
  </view>

  <!-- ---------- 讲义 ---------- -->
  <block wx:if="{{!day.stub && tab === 'lesson'}}">
    <view wx:if="{{lessonBlocks.length}}" class="card">
      <template is="md-blocks" data="{{blocks: lessonBlocks}}" />
      <view wx:if="{{links.length}}" class="lesson-links" bindtap="copyAllLinks" aria-role="button" aria-label="复制讲义里的全部链接">
        <text class="tiny flex-1">讲义里有 {{links.length}} 条链接</text>
        <text class="link">复制全部</text>
      </view>
      <view wx:if="{{!readOnly}}" class="less-regen" bindtap="genLesson" aria-role="button" aria-label="重新生成讲义，现有讲义会被覆盖">重新生成讲义</view>
    </view>

    <view wx:elif="{{lessonBusy}}" class="card">
      <template is="md-blocks" data="{{blocks: lessonBlocks}}" />
      <view class="row gap-12" style="margin-top: 18rpx">
        <view class="caret"></view>
        <text class="thinking">正在写，长文约 40-90 秒</text>
        <!-- 页面内停止入口：真实计费的 BYOK 调用，离开页面不应是唯一的中止手势 -->
        <text class="link" bindtap="stopLesson" aria-role="button" aria-label="停止生成讲义">停止</text>
      </view>
    </view>

    <view wx:else class="card empty">
      <view class="empty-title">今天还没有讲义</view>
      <view class="empty-sub">按六段模板生成：可学资料 / 知识点穷尽 / 完整示例 / 逐步拆解 / 变体与易错 / 双轨验收</view>
      <button class="btn btn-ink" style="margin: 32rpx auto 0; width: 70%" bindtap="genLesson">生成今日讲义</button>
    </view>

    <view wx:if="{{resources.length}}" class="sec-sm">
      <view class="label" style="margin: 0 0 14rpx">资料</view>
      <view class="list">
        <view wx:for="{{resources}}" wx:key="_i" class="item" data-url="{{item.url}}" bindtap="copyLink" aria-role="button" aria-label="复制资料链接：{{item.title}}">
          <view class="flex-1">
            <view class="row gap-8">
              <view class="badge badge-dim">{{item.kindLabel}}</view>
            </view>
            <view class="item-title" style="margin-top: 8rpx">{{item.title}}</view>
            <view class="item-sub">{{item.why}}</view>
          </view>
          <text wx:if="{{item.url}}" class="link">复制</text>
        </view>
      </view>
    </view>
  </block>

  <!-- ---------- 答疑 ---------- -->
  <block wx:if="{{!day.stub && tab === 'qa'}}">
    <view wx:if="{{qaView.length === 0 && !qaBusy}}" class="card empty">
      <view class="empty-title">卡住了就问</view>
      <view class="empty-sub">教练带着今天的讲义回答，不会跑题</view>
    </view>
    <view class="chat">
      <view wx:for="{{qaView}}" wx:key="index" class="msg {{item.role === 'user' ? 'msg-out' : 'msg-in'}}">
        <view wx:if="{{item.role === 'user'}}" class="bubble">{{item.content}}</view>
        <view wx:else class="card-flat" style="max-width: 100%">
          <template is="md-blocks" data="{{blocks: item.blocks}}" />
        </view>
      </view>
      <view wx:if="{{qaBusy}}" class="msg msg-in">
        <view class="card-flat" style="max-width: 100%">
          <template is="md-blocks" data="{{blocks: qaStreamBlocks}}" />
          <view class="row gap-12" style="margin-top: 8rpx">
            <view class="caret"></view>
            <text class="link" bindtap="stopQa" aria-role="button" aria-label="停止生成回答">停止</text>
          </view>
        </view>
      </view>
      <!-- 答疑自动滚底锚点（book/council 同诉求；此区在页面流里，走 pageScrollTo） -->
      <view id="qa-bottom" style="height: 2rpx"></view>
    </view>
  </block>

  <!-- ---------- 验收 ---------- -->
  <block wx:if="{{!day.stub && tab === 'quiz'}}">
    <!-- 已判分 -->
    <block wx:if="{{grade}}">
      <view class="card {{grade.overall === 'pass' ? 'pass-card' : ''}}">
        <view class="row gap-12">
          <view class="badge {{grade.overall === 'pass' ? 'badge-ok' : 'badge-bad'}}">
            {{grade.overall === 'pass' ? '通过' : '未通过'}}
          </view>
        </view>
        <view wx:if="{{grade.summary}}" class="body" style="margin-top: 16rpx; line-height: 1.7">{{grade.summary}}</view>
        <view wx:if="{{grade.reviewAdvice}}" class="review-advice">{{grade.reviewAdvice}}</view>
      </view>

      <view wx:for="{{grade.items}}" wx:key="itemId" class="card">
        <view class="row gap-8">
          <view class="badge badge-{{item.verdictTone}}">{{item.verdictLabel}}</view>
        </view>
        <view class="grade-q">{{item.question}}</view>
        <view class="sub" style="line-height: 1.7">{{item.feedback}}</view>
        <view wx:if="{{item.evidence}}" class="evidence">依据 · {{item.evidence}}</view>
      </view>

      <button wx:if="{{grade.overall !== 'pass' && !readOnly}}" class="btn btn-ink btn-block" style="margin-top: 24rpx" bindtap="retryQuiz">
        再答一遍
      </button>
      <button wx:else class="btn btn-outline btn-block" style="margin-top: 24rpx" bindtap="backToLearn">看讲义</button>
    </block>

    <!-- 答题中 -->
    <block wx:elif="{{quizMode === 'quiz'}}">
      <view wx:for="{{acceptance}}" wx:key="id" class="card">
        <view class="between">
          <view class="badge badge-ink">{{item.kindLabel}}</view>
          <text class="tiny num">第 {{index + 1}}/{{acceptance.length}} 题</text>
        </view>
        <view class="acc-q">{{item.question}}</view>
        <textarea
          class="area"
          placeholder="凭记忆作答，别翻讲义"
          placeholder-class="ph"
          value="{{answers[item.id] || ''}}"
          data-id="{{item.id}}"
          bindinput="onAnswer"
          maxlength="4000"
        />
      </view>
      <button
        class="btn btn-accent btn-block {{canSubmitQuiz && !grading ? '' : 'disabled'}}"
        style="margin-top: 24rpx"
        bindtap="{{canSubmitQuiz && !grading ? 'submitQuiz' : ''}}"
        aria-role="button"
        aria-label="{{grading ? '判分中' : '提交评分'}}"
      >
        {{grading ? "判分中…" : "提交评分"}}
      </button>
      <!-- 判分是 10-60s 的真实计费调用：给出页面内停止入口 -->
      <view wx:if="{{grading}}" class="row" style="margin-top: 14rpx; justify-content: center">
        <text class="link" bindtap="stopGrade" aria-role="button" aria-label="停止判分">停止判分</text>
      </view>
      <view class="tiny" style="margin-top: 14rpx; text-align: center">全部答对才算过；判分以今天的讲义为参照</view>
    </block>

    <!-- 未开始 -->
    <block wx:else>
      <view wx:if="{{readOnly}}" class="card empty">
        <view class="empty-title">这一天已经结束</view>
        <view class="empty-sub">可以回看讲义</view>
      </view>
      <block wx:else>
        <view class="hero">
          <view class="hero-glow"></view>
          <view class="hero-kicker">
            <view class="dot dot-accent"></view>
            {{acceptance.length}} 道题
          </view>
          <view class="hero-title">准备好了就开始</view>
          <view class="hero-sub">用自己的话讲清，别背书。答错的题不会羞辱你，会安排回炉。</view>
          <view class="hero-cta">
            <text class="on-ink-dim" style="font-size: 24rpx">验收不计时</text>
            <view class="hero-btn" bindtap="startQuiz" aria-role="button" aria-label="开始验收">
              开始验收
              <view class="hero-btn-chev"></view>
            </view>
          </view>
        </view>

        <view class="card skip-zone">
          <view class="meta">学不进去也可以跳过，会记一笔</view>
          <view class="row gap-12" style="margin-top: 16rpx">
            <input
              class="input flex-1"
              placeholder="输入「跳过」确认"
              placeholder-class="ph"
              value="{{skipText}}"
              bindinput="onSkipInput"
            />
            <button
              class="btn btn-ghost btn-sm {{skipText === '跳过' ? '' : 'disabled'}}"
              style="flex-shrink: 0"
              bindtap="{{skipText === '跳过' ? 'forceSkip' : ''}}"
            >跳过</button>
          </view>
        </view>
      </block>
    </block>
  </block>

  <view class="page-tail"></view>
</view>

<!-- 答疑输入条：固定在底部 -->
<view wx:if="{{day && !day.stub && tab === 'qa'}}" class="composer">
  <input
    class="composer-field"
    placeholder="问一个具体的问题"
    placeholder-class="ph"
    value="{{qaInput}}"
    confirm-hold
    bindinput="onQaInput"
    bindconfirm="sendQa"
    disabled="{{qaBusy}}"
  />
  <view class="composer-send {{qaInput && !qaBusy ? '' : 'disabled'}}" bindtap="{{qaInput && !qaBusy ? 'sendQa' : ''}}" aria-role="button" aria-label="发送">↑</view>
</view>
