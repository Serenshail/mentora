<view class="page">
  <view class="page-head">
    <view class="title">读书</view>
    <text class="link-action" bindtap="toggleAdd">{{adding ? "收起" : "+ 建档"}}</text>
  </view>

  <view wx:if="{{adding}}" class="add-form">
    <view class="field">
      <text class="field-label">书名</text>
      <input class="field-input" placeholder="例如：思考，快与慢" placeholder-class="ph" value="{{title}}" bindinput="onTitle" />
    </view>
    <view class="field">
      <text class="field-label">作者</text>
      <input class="field-input" placeholder="可选" placeholder-class="ph" value="{{author}}" bindinput="onAuthor" />
    </view>
    <view class="field" style="border-bottom: none">
      <text class="field-label">原文或你的笔记</text>
      <textarea class="area" placeholder="目录、摘录、读书笔记都行" placeholder-class="ph" value="{{pasted}}" bindinput="onPasted" maxlength="8000" />
    </view>
    <button class="btn btn-ink btn-block {{title && !creating ? '' : 'disabled'}}" style="margin-top: 30rpx" bindtap="{{title && !creating ? 'create' : ''}}">
      {{creating ? "正在读这本书…" : "建档并生成路线"}}
    </button>
  </view>

  <view wx:if="{{books.length === 0 && !loading && !adding}}" class="blank">
    <view class="blank-title">书架空的</view>
    <view class="blank-sub">建一本正在读的书，它会带你一章一章读进去</view>
  </view>

  <view wx:for="{{books}}" wx:key="id" class="book" data-id="{{item.id}}" bindtap="openBook" hover-class="tap-dim">
    <view class="between">
      <view class="row gap-12">
        <view class="dot {{item.status === 'done' ? 'dot-ok' : 'dot-accent'}}"></view>
        <text class="micro">{{item.statusLabel}}</text>
      </view>
      <text class="micro num">{{item.chapters}}</text>
    </view>
    <view class="book-title">{{item.title}}</view>
    <view wx:if="{{item.author}}" class="book-author">{{item.author}}</view>
    <view class="bar" style="margin-top: 24rpx">
      <view class="bar-fill" style="width: {{item.progress}}%"></view>
    </view>
  </view>
</view>
