<view class="page">
  <view class="page-head">
    <view class="between">
      <view class="page-head-title">读书伙伴</view>
      <view class="btn btn-outline btn-sm" bindtap="toggleAdd">{{adding ? "收起" : "+ 建档"}}</view>
    </view>
  </view>

  <view wx:if="{{adding}}" class="card">
    <view class="h3" style="margin-bottom: 6rpx">新书建档</view>
    <view class="sub">书名 + 作者 + 粘贴的原文或笔记（可选）→ 生成书籍档案与阅读路线</view>
    <view style="margin-top: 26rpx">
      <text class="field-label">书名</text>
      <input class="input" placeholder="例如：思考，快与慢" placeholder-class="ph" value="{{title}}" bindinput="onTitle" />
    </view>
    <view style="margin-top: 22rpx">
      <text class="field-label">作者</text>
      <input class="input" placeholder="可选" placeholder-class="ph" value="{{author}}" bindinput="onAuthor" />
    </view>
    <view style="margin-top: 22rpx">
      <text class="field-label">原文或你的笔记</text>
      <textarea class="area" placeholder="目录、章节摘录、读书笔记都行（最多 6000 字）" placeholder-class="ph" value="{{pasted}}" bindinput="onPasted" maxlength="8000" />
    </view>
    <button class="btn btn-ink btn-block {{title && !creating ? '' : 'disabled'}}" style="margin-top: 28rpx" bindtap="{{title && !creating ? 'create' : ''}}">
      {{creating ? "正在读这本书…" : "建档，生成阅读路线"}}
    </button>
  </view>

  <view wx:if="{{books.length === 0 && !loading && !adding}}" class="card empty">
    <view class="empty-title">书架是空的</view>
    <view class="empty-sub">建一本正在读的书，读书伙伴会带你一章一章真正读进去</view>
  </view>

  <view wx:for="{{books}}" wx:key="id" class="card book" data-id="{{item.id}}" bindtap="openBook" hover-class="tap-dim">
    <view class="between">
      <view class="badge badge-{{item.status === 'done' ? 'ok' : 'accent'}}">{{item.statusLabel}}</view>
      <text class="meta num">{{item.chapters}}</text>
    </view>
    <view class="h2 book-title">{{item.title}}</view>
    <view wx:if="{{item.author}}" class="sub" style="margin-top: 6rpx">{{item.author}}</view>
    <view class="progress" style="margin-top: 22rpx">
      <view class="progress-fill" style="width: {{item.progress}}%"></view>
    </view>
  </view>
</view>
