<import src="../../wxml/md.wxml" />

<view class="page" wx:if="{{note}}">
  <view class="note-head">
    <view class="title">{{note.title}}</view>
    <view class="note-tags">
      <text wx:if="{{note.domain}}" class="pill">{{note.domain}}</text>
      <text wx:if="{{masteryLabel !== '未测'}}" class="pill pill-accent">{{masteryLabel}}</text>
      <text wx:if="{{note.nextReviewAt}}" class="pill">复习 {{note.nextReviewAt}}</text>
      <text wx:for="{{note.tags}}" wx:key="*this" class="pill">#{{item}}</text>
    </view>
  </view>

  <view class="note-body">
    <view wx:if="{{!blocks.length}}" class="blank-sub" style="text-align: left">这篇还没有正文。</view>
    <template is="md-blocks" data="{{blocks}}" />
  </view>

  <view wx:if="{{outLinks.length}}" class="sec">
    <view class="eyebrow"><view class="eyebrow-mark"></view><text>出链 · {{outLinks.length}}</text></view>
    <view style="margin-top: 8rpx">
      <view wx:for="{{outLinks}}" wx:key="id" class="line" data-id="{{item.id}}" bindtap="openLinked" hover-class="tap-dim">
        <text class="flex-1 accent" style="font-size: 29rpx; font-weight: 500">{{item.title}}</text>
        <text class="chev">›</text>
      </view>
    </view>
  </view>

  <view wx:if="{{backLinks.length}}" class="sec">
    <view class="eyebrow"><view class="eyebrow-mark"></view><text>反向链接 · {{backLinks.length}}</text></view>
    <view style="margin-top: 8rpx">
      <view wx:for="{{backLinks}}" wx:key="id" class="line" data-id="{{item.id}}" bindtap="openLinked" hover-class="tap-dim">
        <text class="flex-1 accent" style="font-size: 29rpx; font-weight: 500">{{item.title}}</text>
        <text class="chev">›</text>
      </view>
    </view>
  </view>
</view>

<view wx:else class="blank">
  <view class="blank-title">笔记不存在</view>
</view>
