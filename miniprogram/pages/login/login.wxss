.login {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 0 44rpx calc(44rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.login-head {
  padding-top: 150rpx;
  padding-bottom: 76rpx;
}
.wordmark {
  font-size: 84rpx;
  font-weight: 700;
  letter-spacing: -3rpx;
  line-height: 1;
  color: var(--ink);
}
.tagline {
  margin-top: 20rpx;
  font-size: 25rpx;
  letter-spacing: 1.4rpx;
  color: var(--ink-3);
}
.login-body { flex: 1; }
.login-btn { margin-top: 52rpx; }
.login-error {
  margin-top: 28rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--bad);
}
.login-foot {
  padding-top: 56rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  text-align: center;
}
.ph { color: #b8bcc4; }
