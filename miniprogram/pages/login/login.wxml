<view class="login">
  <view class="login-head">
    <view class="wordmark">Mentora</view>
    <view class="tagline">学习教练 · 第二大脑 · 人生伙伴</view>
  </view>

  <view class="login-body">
    <view class="segments" style="margin-bottom: 44rpx">
      <view class="segment {{mode === 'login' ? 'segment-on' : ''}}" data-mode="login" bindtap="setMode">登录</view>
      <view class="segment {{mode === 'register' ? 'segment-on' : ''}}" data-mode="register" bindtap="setMode">用邀请码注册</view>
    </view>

    <view wx:if="{{mode === 'register'}}" class="field">
      <text class="field-label">称呼</text>
      <input class="field-input" placeholder="怎么叫你" placeholder-class="ph" value="{{name}}" bindinput="onName" />
    </view>

    <view class="field">
      <text class="field-label">邮箱</text>
      <input class="field-input" placeholder="you@example.com" placeholder-class="ph" value="{{email}}" bindinput="onEmail" />
    </view>

    <view class="field">
      <text class="field-label">密码</text>
      <input class="field-input" password placeholder="至少 6 位" placeholder-class="ph" value="{{password}}" bindinput="onPassword" />
    </view>

    <view wx:if="{{mode === 'register'}}" class="field">
      <text class="field-label">内测邀请码</text>
      <input class="field-input" placeholder="向作者索取" placeholder-class="ph" value="{{inviteCode}}" bindinput="onInvite" />
    </view>

    <view wx:if="{{error}}" class="login-error">{{error}}</view>

    <button class="btn btn-ink btn-block login-btn {{busy ? 'disabled' : ''}}" bindtap="submit">
      {{busy ? "请稍候…" : (mode === "login" ? "登录" : "创建账号")}}
    </button>
  </view>

  <view class="login-foot">同一个账号，网页端的进度在这里同步。</view>
</view>
