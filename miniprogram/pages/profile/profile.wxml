<view class="page">
  <view class="me-head">
    <view class="avatar">{{user ? user.name[0] : "?"}}</view>
    <view class="flex-1">
      <view class="me-name">{{user ? user.name : "未登录"}}</view>
      <view class="me-mail">{{user ? user.email : ""}}</view>
    </view>
  </view>

  <view class="stats">
    <view class="stat"><view class="stat-n num">{{counts.goals}}</view><view class="micro">目标</view></view>
    <view class="stat"><view class="stat-n num">{{counts.notes}}</view><view class="micro">笔记</view></view>
    <view class="stat"><view class="stat-n num">{{counts.books}}</view><view class="micro">书</view></view>
    <view class="stat"><view class="stat-n num">{{counts.sessions}}</view><view class="micro">会话</view></view>
  </view>

  <view wx:if="{{sync}}" class="sync">{{sync}}</view>

  <view class="sec">
    <view class="eyebrow"><view class="eyebrow-mark"></view><text>数据</text></view>
    <view style="margin-top: 8rpx">
      <view class="line" bindtap="pullNow" hover-class="tap-dim">
        <view class="flex-1">
          <view class="line-title">从云端恢复</view>
          <view class="line-sub">以云端为准</view>
        </view>
        <text class="chev">›</text>
      </view>
      <view class="line" bindtap="pushNow" hover-class="tap-dim">
        <view class="flex-1">
          <view class="line-title">推送到云端</view>
          <view class="line-sub">改动会自动推，这是手动兜底</view>
        </view>
        <text class="chev">›</text>
      </view>
      <view class="line" bindtap="copyWebUrl" hover-class="tap-dim">
        <view class="flex-1">
          <view class="line-title">网页版</view>
          <view class="line-sub">引导、笔记编辑、Obsidian 导入在那里</view>
        </view>
        <text class="chev">›</text>
      </view>
    </view>
  </view>

  <view class="sec">
    <view class="eyebrow"><view class="eyebrow-mark"></view><text>后端</text></view>
    <view class="backend-now">{{baseLabel}}</view>
    <view style="margin-top: 8rpx">
      <view class="line" data-id="prod" bindtap="switchBase" hover-class="tap-dim">
        <view class="flex-1">
          <view class="line-title">官方部署</view>
          <view class="line-sub">Vercel · 开发者工具可达</view>
        </view>
        <view wx:if="{{baseId === 'prod'}}" class="dot dot-accent"></view>
      </view>
      <view class="line" data-id="tunnel" bindtap="switchBase" hover-class="tap-dim">
        <view class="flex-1">
          <view class="line-title">本机隧道</view>
          <view class="line-sub">真机预览用，需电脑上服务在跑</view>
        </view>
        <view wx:if="{{baseId === 'tunnel'}}" class="dot dot-accent"></view>
      </view>
      <view class="line" data-id="local" bindtap="switchBase" hover-class="tap-dim">
        <view class="flex-1">
          <view class="line-title">本机开发</view>
          <view class="line-sub">localhost:3000，只在工具里用</view>
        </view>
        <view wx:if="{{baseId === 'local'}}" class="dot dot-accent"></view>
      </view>
    </view>
    <view class="backend-note">大陆真机连不上 Vercel 域名，预览时切「本机隧道」。</view>
  </view>

  <view class="sec">
    <view class="eyebrow"><view class="eyebrow-mark"></view><text>关于</text></view>
    <view class="about">
      Mentora 小程序 · 第一版<br/>
      与网页版同一个账号、同一份数据。
    </view>
    <button class="btn btn-danger btn-block" style="margin-top: 40rpx" bindtap="logout">退出登录</button>
  </view>
</view>
