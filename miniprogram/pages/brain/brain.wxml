<view class="page">
  <view class="brain-head">
    <view class="title">大脑</view>
    <view class="micro num">{{total}} 篇 · {{linkCount}} 连接</view>
  </view>

  <view wx:if="{{dueCount > 0}}" class="due" bindtap="goReview" hover-class="tap-dim">
    <view class="dot dot-warn"></view>
    <text class="flex-1">{{dueCount}} 条到期</text>
    <text class="link-action">复习</text>
  </view>

  <view class="search">
    <input class="input-pill" placeholder="搜标题、正文、标签" placeholder-class="ph" value="{{query}}" bindinput="onQuery" confirm-type="search" />
  </view>

  <scroll-view scroll-x class="folders" wx:if="{{folders.length}}">
    <view class="folder-row">
      <view class="folder {{activeFolder === '' ? 'folder-on' : ''}}" bindtap="pickFolder" data-f="">全部</view>
      <view wx:for="{{folders}}" wx:key="*this" class="folder {{activeFolder === item ? 'folder-on' : ''}}" data-f="{{item}}" bindtap="pickFolder">{{item}}</view>
    </view>
  </scroll-view>

  <view wx:if="{{notes.length === 0 && !loading}}" class="blank">
    <view class="blank-title">{{query ? "没有匹配" : "还是空的"}}</view>
    <view class="blank-sub">{{query ? "换个词试试" : "学习与读书时，知识点会自动落在这里"}}</view>
  </view>

  <view wx:if="{{notes.length}}" style="margin-top: 12rpx">
    <view wx:for="{{notes}}" wx:key="id" class="note-line" data-id="{{item.id}}" bindtap="openNote" hover-class="tap-dim">
      <view class="flex-1">
        <view class="note-title-row">
          <text class="note-title">{{item.title}}</text>
          <view wx:if="{{item.due}}" class="note-due"></view>
        </view>
        <view wx:if="{{item.excerpt}}" class="note-excerpt">{{item.excerpt}}</view>
        <view class="note-meta">{{item.domain}}</view>
      </view>
      <text class="chev">›</text>
    </view>
  </view>
</view>
