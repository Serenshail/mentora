.review { display: flex; align-items: center; gap: 20rpx; border-color: rgba(4, 120, 87, 0.22); }
.folders { margin-top: 20rpx; white-space: nowrap; }
.folder-row { display: inline-flex; gap: 12rpx; padding: 4rpx 0 8rpx; }
.notes { padding: 0 32rpx; }
.note {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.note:last-child { border-bottom: none; }
.note-title {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: -0.2rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex-shrink: 0;
  max-width: 430rpx;
}
.note-excerpt {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--ink-3);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.chev { color: var(--faint); font-size: 30rpx; }
