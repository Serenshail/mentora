.list { padding: 0 32rpx; }
.item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.item:last-child { border-bottom: none; }
.item-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  max-width: 380rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-sub { margin-top: 6rpx; font-size: 23rpx; color: var(--ink-3); }

.seat {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 32rpx;
  border-bottom: 1rpx solid var(--border);
}
.seat:last-child { border-bottom: none; }
.seat-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 18rpx;
  border: 1rpx solid var(--border);
  background: var(--surface-2);
  flex-shrink: 0;
  font-size: 30rpx;
}
/* 无头像席位（认知工具）：深底白字回退，与网页版 fallback 一致 */
.seat .avatar-fallback { background: #1d1d1f; color: #fff; border-radius: 18rpx; }
.seat-img-on { border-color: var(--accent); border-width: 2rpx; }
.seat-name { font-size: 29rpx; font-weight: 600; color: var(--ink); }
.seat-tag {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chat-page { height: 100vh; display: flex; flex-direction: column; box-sizing: border-box; background: var(--bg); }
.chat-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 32rpx;
  background: var(--bg);
  border-bottom: 1rpx solid var(--border);
  flex-shrink: 0;
}
.back-btn { font-size: 44rpx; line-height: 1; color: var(--ink); padding-right: 8rpx; }
.chat-title {
  font-size: 31rpx;
  font-weight: 700;
  letter-spacing: -0.4rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.chat-scroll { flex: 1; min-height: 0; padding: 0 32rpx; }

.rt-row { display: flex; gap: 16rpx; margin-top: 18rpx; }
.rt-img {
  width: 60rpx;
  height: 60rpx;
  border-radius: 14rpx;
  border: 1rpx solid var(--border);
  flex-shrink: 0;
  font-size: 24rpx;
}
.rt-name { font-size: 26rpx; font-weight: 600; color: var(--ink); }
.rt-take {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--ink-2);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  white-space: pre-wrap;
}
