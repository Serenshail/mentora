.page-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 12rpx 0 40rpx;
}
.session-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  max-width: 380rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.trash { font-size: 23rpx; color: var(--ink-3); padding: 10rpx 0 10rpx 20rpx; }
.ph { color: #b8bcc4; }

.pick-hint {
  margin-top: 18rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--ink-3);
}
.seats {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}
.seat {
  width: 206rpx;
  padding: 22rpx 16rpx;
  border-radius: 24rpx;
  background: var(--wash);
  border: 1.5rpx solid transparent;
  box-sizing: border-box;
  text-align: center;
}
.seat-on { border-color: var(--ink); background: var(--paper); }
.seat-mono {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin: 0 auto 14rpx;
  color: #fff;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 64rpx;
  text-align: center;
}
.seat-name {
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.35;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.seat-tag {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: var(--ink-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.over {
  margin-top: 26rpx;
  font-size: 24rpx;
  color: var(--warn);
  text-align: center;
}

/* 对话 */
.chat-page { height: 100vh; display: flex; flex-direction: column; box-sizing: border-box; }
.chat-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 36rpx;
  border-bottom: 1rpx solid var(--hairline);
  flex-shrink: 0;
}
.back { font-size: 44rpx; line-height: 1; color: var(--ink); padding-right: 6rpx; }
.chat-title {
  font-size: 31rpx;
  font-weight: 700;
  letter-spacing: -0.4rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.chat-scroll { flex: 1; min-height: 0; padding: 0 36rpx; }
.chat-composer { flex-shrink: 0; border-top: 1rpx solid var(--hairline); background: var(--paper); }
.chat-composer-inner {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
}

.rt { margin: 26rpx 0; padding: 26rpx 28rpx; border-radius: 26rpx; background: var(--wash); }
.rt-phase {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: var(--ink-3);
  margin-bottom: 20rpx;
}
.rt-row { display: flex; gap: 16rpx; padding: 16rpx 0; }
.rt-mono { width: 52rpx; height: 52rpx; line-height: 52rpx; font-size: 23rpx; margin: 0; flex-shrink: 0; }
.rt-name { font-size: 26rpx; font-weight: 600; color: var(--ink); }
.rt-take {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--ink-2);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  white-space: pre-wrap;
}
