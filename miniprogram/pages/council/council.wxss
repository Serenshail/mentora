/* 伙伴页（tab）：16 席 + 圆桌。
 * 视觉：席位用 3 列网格而不是长列表——一眼看到"都有谁"，
 * 长列表让 16 个人变成 16 行文字，扫不动也记不住。 */

.hero-btn-chev {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #1a1a1a;
  border-top: 3rpx solid #1a1a1a;
  transform: rotate(45deg);
  border-radius: 1rpx;
}

/* ---- 席位网格 ---- */
.seat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.seat {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  padding: 22rpx 12rpx 20rpx;
  border-radius: 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: border-color 0.15s ease, background 0.15s ease, transform 0.12s ease;
}
.seat:active { transform: scale(0.97); }
.seat-on {
  border-color: var(--accent);
  background: var(--accent-wash);
}
.seat-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: var(--surface-2);
  font-size: 32rpx;
  flex-shrink: 0;
}
.seat-name {
  margin-top: 14rpx;
  max-width: 100%;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.3;
  color: var(--ink);
  text-align: center;
}
.seat-tag {
  margin-top: 4rpx;
  max-width: 100%;
  font-size: 19rpx;
  line-height: 1.3;
  color: var(--ink-3);
  text-align: center;
}
.seat-check {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: var(--accent);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---- 对话 ----
 * 高度不能用 100vh - 固定值：导航高度 = 状态栏 + 44px，随机型变化。
 * 由 JS 量出真实导航高度后，通过内联 style 传给这里（见 -navH 变量）。 */
.chat-wrap {
  height: calc(100vh - var(--nav-h, 64px));
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.chat-scroll {
  flex: 1;
  min-height: 0;
  padding: 0 32rpx;
}

/* 圆桌运行态面板：不用整块白卡，而是每席一条，扫读更快 */
.rt-panel {
  margin: 20rpx 0;
  padding: 24rpx;
  border-radius: 28rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
}
.rt-row {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid var(--border);
}
.rt-row:first-child { border-top: none; }
.rt-img {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  font-size: 22rpx;
}
.rt-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}
.rt-take {
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--ink-2);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  white-space: pre-wrap;
}
