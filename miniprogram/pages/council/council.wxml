<import src="../../wxml/md.wxml" />

<!-- ===== 会话列表 ===== -->
<view wx:if="{{view === 'list'}}" class="page">
  <view class="page-head">
    <view class="title">人生伙伴</view>
    <text class="link-action" bindtap="openPick">+ 新会话</text>
  </view>

  <view wx:if="{{sessions.length === 0}}" class="blank">
    <view class="blank-title">还没有对话</view>
    <view class="blank-sub">和某一位单独聊，或者开一张圆桌\n让几个人同时回答你的问题</view>
  </view>

  <view wx:for="{{sessions}}" wx:key="id" class="line" data-id="{{item.id}}" bindtap="openSession" hover-class="tap-dim">
    <view class="flex-1">
      <view class="row gap-12">
        <text class="session-name">{{item.title}}</text>
        <text wx:if="{{item.roundtable}}" class="pill pill-accent">圆桌</text>
      </view>
      <view class="line-sub">{{item.count}} 条 · {{item.when}}</view>
    </view>
    <view class="trash" data-id="{{item.id}}" catchtap="deleteSession">删除</view>
  </view>
</view>

<!-- ===== 开新会话 ===== -->
<view wx:if="{{view === 'pick'}}" class="page">
  <view class="page-head">
    <view class="title">找谁</view>
    <text class="link-action" bindtap="back">返回</text>
  </view>

  <view class="segments" style="margin-bottom: 12rpx">
    <view class="segment {{pickMode === 'single' ? 'segment-on' : ''}}" data-mode="single" bindtap="switchPickMode">单独聊</view>
    <view class="segment {{pickMode === 'roundtable' ? 'segment-on' : ''}}" data-mode="roundtable" bindtap="switchPickMode">圆桌</view>
  </view>
  <view class="pick-hint">
    {{pickMode === 'single' ? "点谁就跟谁聊" : "选 2–6 席，各自独立发言，最后主持人出纪要"}}
  </view>

  <view class="sec-sm">
    <view class="eyebrow"><view class="eyebrow-mark"></view><text>人物</text></view>
    <view class="seats">
      <view wx:for="{{allSeats}}" wx:key="id" wx:if="{{!item.concept}}" class="seat {{picked[item.id] ? 'seat-on' : ''}}" data-id="{{item.id}}" bindtap="toggleSeat" hover-class="tap-dim">
        <view class="seat-mono" style="background: {{item.color}}">{{item.name[0]}}</view>
        <view class="seat-name">{{item.name}}</view>
        <view class="seat-tag">{{item.tag}}</view>
      </view>
    </view>
  </view>

  <view class="sec">
    <view class="eyebrow"><view class="eyebrow-mark"></view><text>思维工具</text></view>
    <view class="seats">
      <view wx:for="{{allSeats}}" wx:key="id" wx:if="{{item.concept}}" class="seat {{picked[item.id] ? 'seat-on' : ''}}" data-id="{{item.id}}" bindtap="toggleSeat" hover-class="tap-dim">
        <view class="seat-mono" style="background: {{item.color}}">{{item.name[0]}}</view>
        <view class="seat-name">{{item.name}}</view>
        <view class="seat-tag">{{item.tag}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{pickMode === 'roundtable'}}">
    <view wx:if="{{pickedCount > 6}}" class="over">已选 {{pickedCount}} 席，会慢也会贵</view>
    <button class="btn btn-ink btn-block {{pickedCount >= 2 ? '' : 'disabled'}}" style="margin-top: 48rpx" bindtap="{{pickedCount >= 2 ? 'startRoundtable' : ''}}">
      开桌 · {{pickedCount}} 席
    </button>
  </view>
</view>

<!-- ===== 对话 ===== -->
<view wx:if="{{view === 'chat'}}" class="chat-page">
  <view class="chat-head">
    <text class="back" bindtap="back">‹</text>
    <view class="flex-1">
      <view class="chat-title">{{session.title}}</view>
      <view wx:if="{{session.personaTag}}" class="micro">{{session.personaTag}}</view>
    </view>
    <text wx:if="{{session.isRoundtable}}" class="pill pill-accent">圆桌</text>
  </view>

  <scroll-view scroll-y class="chat-scroll">
    <view class="chat">
      <view wx:if="{{chatView.length === 0 && !busy}}" class="blank">
        <view class="blank-title">把你的问题放桌上</view>
        <view class="blank-sub">{{session.isRoundtable ? "几席各自回答，主持人最后综合" : "直接说，越具体越好"}}</view>
      </view>

      <view wx:for="{{chatView}}" wx:key="index" class="msg {{item.role === 'user' ? 'msg-user' : 'msg-ai'}}">
        <view wx:if="{{item.role === 'user'}}" class="bubble">{{item.content}}</view>
        <block wx:else>
          <template is="md-blocks" data="{{blocks: item.blocks}}" />
        </block>
      </view>

      <!-- 圆桌进度 -->
      <view wx:if="{{busy && rtSeats.length}}" class="rt">
        <view class="rt-phase">{{rtPhase === 'host' ? "主持人正在综合" : "各自在想"}}</view>
        <view wx:for="{{rtSeats}}" wx:key="id" class="rt-row">
          <view class="seat-mono rt-mono" style="background: {{item.color}}">{{item.name[0]}}</view>
          <view class="flex-1">
            <view class="between">
              <text class="rt-name">{{item.name}}</text>
              <text class="micro {{item.status === 'failed' ? 'bad' : item.status === 'done' ? 'ok' : ''}}">
                {{item.status === 'done' ? '说完了' : item.status === 'failed' ? '失败' : item.status === 'streaming' ? '说话中' : '等待'}}
              </text>
            </view>
            <view wx:if="{{item.take}}" class="rt-take">{{item.take}}</view>
          </view>
        </view>
      </view>

      <view wx:if="{{busy && (!rtSeats.length || rtPhase === 'host')}}" class="msg msg-ai">
        <template is="md-blocks" data="{{blocks: rtPhase === 'host' ? rtHostBlocks : streamBlocks}}" />
        <view class="row" style="margin-top: 12rpx">
          <view class="caret"></view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="chat-composer">
    <view class="chat-composer-inner">
      <input class="composer-input" placeholder="{{session.isRoundtable ? '把决策问题抛给圆桌' : '说点什么'}}" placeholder-class="ph" value="{{input}}" confirm-hold bindinput="onInput" bindconfirm="send" disabled="{{busy}}" />
      <view class="composer-send {{input && !busy ? '' : 'disabled'}}" bindtap="{{input && !busy ? 'send' : ''}}">↑</view>
    </view>
  </view>
</view>
