/* 复习页：一条队列、四阶段。
 * 信息策略 —— 任何时刻屏幕上只有一个"该做的动作"：
 * idle 是「开始这轮」，answer 是「提交判卷」，graded 是「下一条」。 */

.hero-btn-chev {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #1a1a1a;
  border-top: 3rpx solid #1a1a1a;
  transform: rotate(45deg);
  border-radius: 1rpx;
}

/* 题目本身是这一页的主角，字号要比正文大一档 */
.q {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: -0.6rpx;
  line-height: 1.6;
  color: var(--ink);
  white-space: pre-wrap;
}

.evidence {
  margin-top: 22rpx;
  padding-left: 20rpx;
  border-left: 4rpx solid var(--border-strong);
  font-size: 23rpx;
  line-height: 1.65;
  color: var(--ink-3);
}

.stats {
  display: flex;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--border);
}
