.q {
  margin: 22rpx 0 26rpx;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: -0.6rpx;
  line-height: 1.55;
  color: var(--ink);
  white-space: pre-wrap;
}
.evidence {
  margin-top: 22rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: var(--surface-2);
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--ink-3);
}
.stats { display: flex; padding-bottom: 22rpx; border-bottom: 1rpx solid var(--border); }
.stat { flex: 1; }
.stat-n { font-size: 48rpx; font-weight: 700; letter-spacing: -1.4rpx; line-height: 1.2; color: var(--ink); }
