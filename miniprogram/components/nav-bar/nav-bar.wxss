/* 导航栏：极简。它不是容器，是"你在哪"的一行提示。 */
.nav {
  background: var(--bg);
}
.nav-bar {
  display: flex;
  align-items: center;
  padding: 0 32rpx;
}
.nav-bar-line {
  border-bottom: 1rpx solid var(--border);
}
.nav-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  flex: 1;
}

/* 返回：44px 触摸区 + CSS 画的 chevron（不依赖图标字体/图片） */
.nav-back {
  width: 72rpx;
  height: 72rpx;
  margin-left: -18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  flex-shrink: 0;
}
.nav-back-tap {
  background: var(--ink-wash);
}
.nav-chev {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid var(--ink);
  border-bottom: 4rpx solid var(--ink);
  transform: rotate(45deg);
  margin-left: 6rpx;
  border-radius: 2rpx;
}

/* tab 页的字标：与网页侧栏同一份资产、同一个类名（.font-brand = Great Vibes）。
 * 手写体在导航栏高度下需要更大字号才立得住——网页侧栏用 30px，这里等比取 40rpx。 */
.nav-brand {
  font-size: 40rpx;
  font-weight: 400;
  color: var(--ink);
}

.nav-title {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: -0.3rpx;
  color: var(--ink);
  flex: 1;
  min-width: 0;
}

.nav-fade {
  background: var(--bg);
}
